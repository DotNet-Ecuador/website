---
import tiktokIcon from "../assets/icons/tik_tok.png";
import instagramIcon from "../assets/icons/instagram.png";
import linkedinIcon from "../assets/icons/linkedin.png";
import whatsappIcon from "../assets/icons/whatsapp.png";
import youtubeIcon from "../assets/icons/youtube.png";
import spotifyIcon from "../assets/icons/spotify.png";

import { Image } from "astro:assets";
import Header from "../components/Header.astro";
import Accordion from "../components/Accordion.astro";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>.NET Ecuador</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap"
      rel="stylesheet"
    />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Poppins", sans-serif;
        background-color: #eef2f7;
        color: #333;
      }

      .container {
        width: 90%;
        max-width: 900px;
        margin: auto;
        padding: 20px;
      }

      .banner {
        background: linear-gradient(135deg, #1f085a, #630072);
        color: white;
        text-align: center;
        padding: 50px 20px;
        border-radius: 12px;
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
      }

      .banner h2 {
        font-size: 28px;
        margin-bottom: 10px;
      }

      .banner p {
        font-size: 18px;
      }

      .formulario {
        background: white;
        padding: 25px;
        margin-top: 25px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
      }

      .formulario h3 {
        text-align: center;
        font-size: 22px;
        margin-bottom: 10px;
      }

      .formulario input {
        font-family: "Poppins";
        width: 100%;
        padding: 14px;
        margin-top: 10px;
        border: 1px solid #ccc;
        border-radius: 5px;
        font-size: 16px;
      }

      .formulario button {
        width: 100%;
        padding: 14px;
        margin-top: 15px;
        background: #630072;
        color: white;
        border: none;
        border-radius: 5px;
        font-size: 16px;
        cursor: pointer;
        transition: 0.3s ease-in-out;
      }

      .formulario button:hover {
        background: #9600ad;
        transform: translateY(-2px);
      }

      .social-media {
        text-align: center;
        margin-top: 25px;
      }

      .social-media h3 {
        font-size: 20px;
        margin-bottom: 10px;
      }

      .social-media a {
        display: inline-block;
        margin: 10px;
        transition: 0.3s ease-in-out;
      }

      .social-media a:hover {
        transform: scale(1.2);
      }

      .whatsapp_podcast {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 15px;
        margin-top: 25px;
      }

      .whatsapp_podcast h3 {
        font-size: 20px;
        text-align: center;
      }

      .whatsapp_podcast a img {
        transition: transform 0.3s ease-in-out;
      }

      .whatsapp_podcast a img:hover {
        transform: scale(1.1);
      }

      .acordeon {
        margin-top: 30px;
      }

      .acordeon h3 {
        text-align: center;
        font-size: 22px;
        margin-bottom: 15px;
      }
      .acordeon div {
        display: none;
        padding: 12px;
        background-color: #f1f1f1;
        border-radius: 5px;
        margin-top: 5px;
      }

    </style>
  </head>
  <body>
    <Header />

    <div class="container">
      <section class="banner">
        <h2>Bienvenido a la Comunidad .NET Ecuador</h2>
        <p>
          Únete a nuestra comunidad y aprende sobre .NET y tecnologías
          relacionadas.
        </p>
      </section>

      <section class="formulario">
        <h3>¡Únete a nosotros!</h3>
        <form>
          <input type="text" placeholder="Nombres Completos" required />
          <input type="email" placeholder="Correo Electrónico" required />
          <button type="submit">Suscribirse</button>
        </form>
      </section>

      <section class="social-media">
        <h3>Síguenos en Redes Sociales</h3>
        <a href="https://www.tiktok.com/@dotnetecuador">
          <Image src={tiktokIcon} alt={"tiktok"} width={50} />
        </a>
        <a href="https://www.instagram.com/dotnet_ecuador/">
          <Image src={instagramIcon} alt={"instagram"} width={50} />
        </a>
        <a href="https://www.youtube.com/@dotnet-ecuador">
          <Image src={youtubeIcon} alt={"youtube"} width={50} />
        </a>
        <a href="https://www.linkedin.com/company/dotnet-ecuador/?originalSubdomain=ec">
          <Image src={linkedinIcon} alt={"linkedin"} width={50} />
        </a>
      </section>

      <section class="whatsapp_podcast">
        <h3>Únete a nuestro grupo de WhatsApp</h3>
        <a href="#"><Image src={whatsappIcon} alt={"whatsapp"} width={50} /></a>
        <h3>Escucha nuestro podcast</h3>
        <a href="https://open.spotify.com/show/0UUXZpDtW89OFGxmcy08RI?si=3f19ba238de2464e"><Image src={spotifyIcon} alt={"spotify"} width={50} /></a>
      </section>

      <section class="acordeon">
        <h3>Preguntas Frecuentes</h3>

        <Accordion
          title="¿Cómo puedo unirme a la comunidad .NET Ecuador?"
          desc="Puedes unirte a nuestra comunidad asistiendo a nuestros eventos, participando en nuestros proyectos y uniéndote a nuestros canales de comunicación como redes sociales y grupos de chat."
        />
        <Accordion
          title="¿Cómo puedo estar al tanto de los próximos eventos?"
          desc="Puedes seguirnos en nuestras redes sociales, suscribirte a nuestro boletín de noticias, y visitar nuestra página web para obtener información actualizada sobre los próximos eventos."
        />
        <Accordion
          title="¿Puedo colaborar como presentador en algún evento?"
          desc="¡Sí! Siempre estamos buscando nuevos presentadores. Si tienes una charla o taller que te gustaría compartir, por favor contáctanos a través de nuestro formulario de contacto en la página web."
        />
        <Accordion
          title="¿Qué habilidades necesito para ser parte de la comunidad?"
          desc="Nuestra comunidad está abierta tanto a principiantes como a desarrolladores experimentados. Lo importante es tu interés en aprender y compartir sobre .NET y tecnologías relacionadas."
        />
        <Accordion
          title="¿Cómo puedo contribuir a los proyectos de la comunidad?"
          desc="Puedes unirte a los proyectos de la comunidad a través de nuestro repositorio de GitHub. https://github.com/DotNet-Ecuador "
        />
        <Accordion
          title="¿La comunidad ofrece algún tipo de mentoría?"
          desc="Sí, tenemos un programa de mentoría donde miembros experimentados ayudan a guiar a los nuevos desarrolladores en su camino profesional."
        />
      </section>
    </div>
  </body>
</html>
