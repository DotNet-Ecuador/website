---
import { Image } from 'astro:assets';
import Header from '../components/Header.astro';
import EventCard from '../components/EventCard.astro';
import "../assets/styles/global.css";

---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Eventos - .NET Ecuador</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap"
      rel="stylesheet" href="../assets/styles/global.css"
    />
  </head>
  <body>
    <Header />

    <div class="event-container">

      <h1>Próximos eventos en <span style="color: #630072;">DotNet Ecuador</span></h1>
      <EventCard idImage={["csharp1", "csharp2", "csharp3"]} 
      images={['https://media.licdn.com/dms/image/v2/C4E1BAQGD8r2Pv9iPpg/company-background_10000/company-background_10000/0/1609965184925/csharpcorner_cover?e=2147483647&v=beta&t=p1xvHK2SI1o2c8rwXGCyVjpF7INq4CfAxVZhPcSGs_A', 
      "https://conferencealert.com/blog/wp-content/uploads/2020/03/poster2.jpg",
      "https://www.unr.edu/main/images/news/2024/October/shamik-sengupta.jpg"]} 
      title='Conferencia C#' description='Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.' date='03 de Marzo' location='Escuela Politécnica Nacional' reverse={false}/>
      <EventCard idImage={["slide1"]} 
      images={['https://lh3.googleusercontent.com/proxy/Aw0nH5dOq4z6H3sSpXkMfSXNmjr-RgA-JHoSX8I_SOxo0_Q9Zxr8B6hBkV2fr861YQyyyxcaBS8gY8lQ8d8Du4oegd_jdpiv8dv9ytPU3MjfTsbHWxoig4dDk5SdqBmByOf8cdnzjgQLeo8P_-1o98I16jfs7A64zg']} 
      title='Conferencia 2' description='Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.' date='10 al 15 de Marzo' location='ESPOL' reverse={true}/>
  </div>
  </body>
</html>


