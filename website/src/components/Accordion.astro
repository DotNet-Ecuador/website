---
import accordionClosed from "../assets/icons/abajo.png";
import accordionOpen from "../assets/icons/arriba.png";
import "../assets/styles/global.css";

export interface Props {
  title: string;
  desc: string;
}

const { title, desc } = Astro.props;
---
<div class ="animate-on-scroll">
  <div class="accordion">
    <div class="accordion-item">
      <button
        class="accordion-header"
        onclick="toggleAccordion(this)"
        data-open={accordionOpen.src} 
        data-closed={accordionClosed.src} 
      >
        <span>{title}</span>
        <img
          src={accordionClosed.src} 
          alt="Accordion Icon"
          width="18"
          height="18"
          class="accordion-icon"
        />
      </button>
      <div class="accordion-content">
        {desc}
      </div>
    </div>
  </div>
</div>


<script is:inline>
  function toggleAccordion(button) {
    const content = button.nextElementSibling;
    const icon = button.querySelector(".accordion-icon");

    const openSrc = button.getAttribute("data-open"); 
    const closedSrc = button.getAttribute("data-closed"); 

    if (content.classList.contains("open")) {
      content.classList.remove("open");
      icon.src = closedSrc; 
      icon.classList.remove("rotated");
    } else {
      content.classList.add("open");
      icon.src = openSrc; 
      icon.classList.add("rotated");
    }
  }
</script>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const elements = document.querySelectorAll(".animate-on-scroll");

    const observer = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            observer.unobserve(entry.target); 
          }
        });
      },
      { threshold: 0.2 } 
    );

    elements.forEach((el) => observer.observe(el));
  });
</script>
