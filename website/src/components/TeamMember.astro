---
const { imageUrl, name, role } = Astro.props;
---

<div class="profile">
  <img src={imageUrl} alt={name} class="profile-image" />
  <h2 class="profile-name">{name}</h2>
  <p class="profile-description">{role}</p>
</div>

<style>
  .profile {
    text-align: center;
    width: 210px;
    margin: 10px;
    padding: 1.5rem;
    color: #1f085a;
    background-color: #ffffff;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    margin-bottom: 2%;
    word-wrap: break-word;
    animation-name: moveIn;
    animation-duration: 1.5s;
  }

  @keyframes moveIn {
    0%{  
        translate: 0px 120px;
    }
    100%{
        translate: 0px 0px;
    }
  }

  .profile:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
  }

  .profile-image {
    width: 210px;
    height: 210px;
    border-radius: 50%;
    margin-bottom: 1rem;
  }

  .profile-name {
    font-size: 1.75rem;
    margin: 0.5rem 0;
    font-weight: bold;
    white-space: normal;
    overflow-wrap: break-word;
  }

  .profile-description {
    font-size: 1.1rem;
    color: #444;
  }
</style>
