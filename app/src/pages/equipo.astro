---
import { Image } from "astro:assets";
import TeamMember from "../components/TeamMember.astro";
import Button from "../components/Button.astro";
import whatsappIcon from "../assets/icons/whatsapp.png";
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { SEO_PAGES_CONFIG } from "../config/seo";

const pageConfig = SEO_PAGES_CONFIG['/equipo'];
---

<Layout
  title={pageConfig.title}
  description={pageConfig.description}
  keywords={pageConfig.keywords.join(', ')}>
  
  <Breadcrumbs 
    items={[
      { name: 'Nuestro Equipo', url: '/equipo' }
    ]} 
  />
  description="Conoce al increíble equipo detrás de DotNet Ecuador. Profesionales apasionados por la tecnología y el crecimiento de la comunidad.">
  
  <!-- Hero Section with modern design -->
  <section class="relative py-16 sm:py-20 lg:py-28 overflow-hidden"
           style="margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%); padding-left: calc(50vw - 50%); padding-right: calc(50vw - 50%);">
    <!-- Background with gradients and glass effect -->
    <div class="absolute inset-0 bg-gradient-to-br from-primary-50 via-neutral-50 to-primary-100"></div>
    <div class="absolute inset-0 bg-gradient-to-tr from-primary-900/5 via-transparent to-primary-600/10"></div>
    
    <!-- Decorative elements -->
    <div class="absolute -top-20 -right-20 w-72 h-72 bg-gradient-to-br from-primary-400/15 to-primary-600/25 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute -bottom-20 -left-20 w-72 h-72 bg-gradient-to-tr from-primary-700/15 to-primary-500/25 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
    <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-48 h-48 bg-gradient-to-br from-primary-300/10 to-primary-800/20 rounded-full blur-2xl animate-float"></div>
    
    <div class="relative z-10 container-custom">
      <!-- Header Section -->
      <div class="text-center">
        <div class="animation-fade-scale">
          <h1 class="text-4xl sm:text-5xl lg:text-7xl font-bold mb-6 leading-tight">
<span class="animate-gradient-text font-extrabold">
              Conoce a nuestro equipo
            </span>
          </h1>
        </div>
        <div class="animation-fade-scale" style="animation-delay: 200ms;">
          <p class="text-lg sm:text-xl lg:text-2xl text-neutral-700 max-w-4xl mx-auto leading-relaxed">
            Un equipo diverso de profesionales comprometidos con el crecimiento de la comunidad .NET en Ecuador. 
            <span class="text-primary-600 font-medium">Innovadores, colaboradores y apasionados por la tecnología.</span>
          </p>
        </div>
        
      </div>
    </div>
  </section>
  
  <div class="container-custom px-4 sm:px-6 lg:px-8 py-8">

    <!-- Team Grid -->
    <section class="team-grid-stagger mb-16 sm:mb-20 lg:mb-24">
      <TeamMember 
        imageUrl="https://i.imgur.com/GaxB6y4.jpeg" 
        name="Byron Duarte" 
        role="Founder" 
        delay="100ms"
      />
      <TeamMember 
        imageUrl="https://i.imgur.com/Tvqk8kS.jpeg" 
        name="Kevin Santacruz" 
        role="Software Engineer" 
        delay="200ms"
      />
      <TeamMember 
        imageUrl="https://i.imgur.com/qdLPSjf.jpeg" 
        name="Cristopher Coronado" 
        role="Software Engineer" 
        delay="300ms"
      />
      <TeamMember 
        imageUrl="https://i.imgur.com/KVXu8G0.jpeg" 
        name="Josiel Ramos" 
        role="Diseñador Gráfico" 
        delay="400ms"
      />
      <TeamMember 
        imageUrl="https://i.imgur.com/b712nbL.jpeg" 
        name="Daniel Jaramillo" 
        role="Desarrollador Web" 
        delay="500ms"
      />
      <TeamMember 
        imageUrl="https://i.imgur.com/a7BCKzB.jpeg" 
        name="Jose Villavicencio" 
        role="Software Engineer" 
        delay="600ms"
      />
      <TeamMember 
        imageUrl="https://i.imgur.com/IrgGlMR.jpeg" 
        name="Esleiter Fajardo" 
        role="Desarrollador Web" 
        delay="700ms"
      />
      <TeamMember 
        imageUrl="https://i.imgur.com/IXP5Qxk.jpeg" 
        name="Anthony San Lucas" 
        role="Desarrollador Web" 
        delay="800ms"
      />
      <TeamMember 
        imageUrl="https://i.imgur.com/vkoVSGX.jpeg" 
        name="Samuel Murillo" 
        role="Unity Game Developer" 
        delay="900ms"
      />
      <TeamMember 
        imageUrl="/darlin_vite.jpg" 
        name="Darlin Vite" 
        role="Desarrollador Web" 
        delay="1000ms"
      />
    </section>

  </div>

  <script>
    function setupIntersectionObserver() {
      const observerOptions = {
        threshold: 0.15,
        rootMargin: '0px 0px -50px 0px'
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, observerOptions);

      // Observe fade-in and fade-scale animations
      const fadeElements = document.querySelectorAll('.animation-fade-in, .animation-fade-scale');
      fadeElements.forEach((el) => observer.observe(el));
      
      // Observe team member cards with staggered animation
      const teamCards = document.querySelectorAll('.team-member-card');
      teamCards.forEach((card, index) => {
        observer.observe(card);
      });
    }

    function addParallaxEffect() {
      const decorativeElements = document.querySelectorAll('.absolute');
      
      window.addEventListener('scroll', () => {
        const scrolled = window.pageYOffset;
        const rate = scrolled * -0.5;
        
        decorativeElements.forEach((el, index) => {
          if (el.classList.contains('blur-3xl') || el.classList.contains('blur-2xl')) {
            el.style.transform = `translateY(${rate * (0.2 + index * 0.1)}px)`;
          }
        });
      });
    }

    function addHoverEffects() {
      const teamCards = document.querySelectorAll('.team-member-card');
      
      teamCards.forEach(card => {
        card.addEventListener('mouseenter', () => {
          // Add floating effect to other cards
          teamCards.forEach(otherCard => {
            if (otherCard !== card) {
              otherCard.style.transform = 'translateY(-2px) scale(0.98)';
              otherCard.style.opacity = '0.7';
            }
          });
        });

        card.addEventListener('mouseleave', () => {
          // Reset all cards
          teamCards.forEach(otherCard => {
            otherCard.style.transform = '';
            otherCard.style.opacity = '';
          });
        });
      });
    }

    document.addEventListener('DOMContentLoaded', () => {
      setupIntersectionObserver();
      addParallaxEffect();
      addHoverEffects();
      
      // Add dynamic gradient animation to title
      const gradientTitle = document.querySelector('.animate-gradient-text');
      if (gradientTitle) {
        gradientTitle.addEventListener('mouseenter', () => {
          gradientTitle.style.animationDuration = '4s';
        });
        gradientTitle.addEventListener('mouseleave', () => {
          gradientTitle.style.animationDuration = '8s';
        });
      }
    });
  </script>
</Layout>
