---
import Layout from '../layouts/Layout.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import Button from '../components/Button.astro'
import EventCardV2 from '../components/EventCardV2.astro'
import { SEO_PAGES_CONFIG } from '../config/seo'
import { EVENTS } from '../data/events'

const pageConfig = SEO_PAGES_CONFIG['/eventos']

const confirmedEvents = EVENTS.filter(e => e.status === 'confirmed')
const tentativeEvents = EVENTS.filter(e => e.status === 'tentative')
---

<Layout
  title={pageConfig.title}
  description={pageConfig.description}
  keywords={pageConfig.keywords.join(', ')}
>

  <!-- ─── Hero ─────────────────────────────────────────────────────────── -->
  <section
    class="relative pb-16 sm:pb-20 pt-4 overflow-hidden"
    style="margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%); padding-left: calc(50vw - 50%); padding-right: calc(50vw - 50%);"
  >
    <div class="absolute inset-0 bg-gradient-to-br from-primary-50 via-neutral-50 to-primary-100"></div>
    <div class="absolute -top-20 -right-20 w-72 h-72 bg-gradient-to-br from-primary-400/15 to-primary-600/25 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-20 -left-20 w-72 h-72 bg-gradient-to-tr from-primary-700/15 to-primary-500/25 rounded-full blur-3xl"></div>

    <div class="relative z-10 container-custom">
      <Breadcrumbs items={[{ name: 'Eventos', url: '/eventos' }]} variant="light" />

      <div class="text-center mt-8">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold mb-5 leading-tight font-display">
          <span class="animate-gradient-text">Próximos Eventos</span>
        </h1>
        <p class="text-lg sm:text-xl text-neutral-600 max-w-2xl mx-auto leading-relaxed">
          Meetups, paneles y workshops para la comunidad .NET y los líderes empresariales del Ecuador.
        </p>
      </div>
    </div>
  </section>

  <div class="container-custom px-4 sm:px-6 lg:px-8 py-12">

    <!-- ─── Confirmed events ───────────────────────────────────────────── -->
    {confirmedEvents.length > 0 && (
      <section aria-labelledby="confirmed-heading" class="mb-14">
        <h2 id="confirmed-heading" class="section-heading mb-8">
          <span class="section-heading__dot section-heading__dot--cyan"></span>
          Eventos confirmados
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
          {confirmedEvents.map(event => (
            <EventCardV2 event={event} />
          ))}
        </div>
      </section>
    )}

    <!-- ─── Divider (only when both sections exist) ────────────────────── -->
    {confirmedEvents.length > 0 && tentativeEvents.length > 0 && (
      <hr class="border-neutral-200 mb-14" />
    )}

    <!-- ─── Tentative events ───────────────────────────────────────────── -->
    {tentativeEvents.length > 0 && (
      <section aria-labelledby="tentative-heading" class="mb-14">
        <h2 id="tentative-heading" class="section-heading mb-2">
          <span class="section-heading__dot section-heading__dot--purple"></span>
          En planificación
        </h2>
        <p class="text-sm text-neutral-500 mb-8 ml-5">
          Fechas por confirmar — activa las notificaciones para no perderte nada.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
          {tentativeEvents.map(event => (
            <EventCardV2 event={event} />
          ))}
        </div>
      </section>
    )}

    <!-- ─── Sponsor CTA ────────────────────────────────────────────────── -->
    <section class="mb-14">
      <div class="sponsor-cta">
        <div class="sponsor-cta__content">
          <span class="sponsor-cta__eyebrow">Para empresas</span>
          <h3 class="sponsor-cta__title">¿Tu empresa quiere estar presente?</h3>
          <p class="sponsor-cta__text">
            Conecta con cientos de desarrolladores .NET. Nuestros eventos son el espacio ideal para
            presentar tu marca, producto o iniciativa ante la comunidad tech más activa del Ecuador.
          </p>
        </div>
        <div class="sponsor-cta__action">
          <Button variant="outline" href="/contacto">
            Hablar con el equipo
          </Button>
        </div>
      </div>
    </section>

    <!-- ─── Speaker CTA ────────────────────────────────────────────────── -->
    <section class="text-center mb-12">
      <div class="card p-8 max-w-xl mx-auto gradient-primary text-white">
        <h3 class="text-xl sm:text-2xl font-semibold font-display mb-3">
          ¿Quieres ser ponente?
        </h3>
        <p class="text-base mb-6 opacity-90">
          Comparte tu conocimiento con la comunidad. Contáctanos para proponer tu charla o taller.
        </p>
        <a
          href="/contacto"
          class="inline-block bg-white text-primary-900 px-6 py-3 rounded-lg font-medium hover:bg-neutral-100 transition-colors min-h-[44px]"
        >
          Proponer Charla
        </a>
      </div>
    </section>

  </div>
</Layout>

<style>
  .section-heading {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: 'Exo 2', sans-serif;
    font-size: 1.125rem;
    font-weight: 700;
    color: #100123;
  }

  .section-heading__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    flex-shrink: 0;
  }

  .section-heading__dot--cyan   { background: #0ea5e9; }
  .section-heading__dot--purple { background: #8b5dff; }

  /* ─── Sponsor CTA ────────────────────────────────────── */
  .sponsor-cta {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    background: white;
    border: 1px solid #e4e4e7;
    border-radius: 1.25rem;
    padding: 2rem;
    box-shadow: 0 4px 8px rgba(0,0,0,0.06);
  }

  @media (min-width: 768px) {
    .sponsor-cta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .sponsor-cta__content {
    flex: 1;
  }

  .sponsor-cta__eyebrow {
    display: inline-block;
    font-family: 'Jost', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #0ea5e9;
    margin-bottom: 0.5rem;
  }

  .sponsor-cta__title {
    font-family: 'Exo 2', sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: #100123;
    margin: 0 0 0.5rem 0;
  }

  .sponsor-cta__text {
    font-family: 'Jost', sans-serif;
    font-size: 0.9rem;
    color: #52525b;
    line-height: 1.6;
    max-width: 52ch;
    margin: 0;
  }

  .sponsor-cta__action {
    flex-shrink: 0;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible')
            observer.unobserve(entry.target)
          }
        })
      },
      { threshold: 0.1, rootMargin: '0px 0px -30px 0px' }
    )

    document.querySelectorAll('.animation-fade-up').forEach(el => observer.observe(el))
  })
</script>
