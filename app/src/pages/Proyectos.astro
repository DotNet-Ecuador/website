---
import Layout from '../layouts/Layout.astro';
import Accordion from '../components/Accordion.astro';
---

<Layout
  title="Proyectos"
  description="">
          <h1 style="color: #630072; text-align: center; margin-bottom: 2.5rem; background: transparent;">Envíanos tus Pull Requests</h1>
          <div class="proyectos-row" style="padding-top: 1.5rem; overflow: visible;">
    <a href="https://github.com/DotNet-Ecuador/website" class="proyecto-card" style="text-decoration: none; color: inherit;">
      <h2>Website</h2>
      <p>Página web de la comunidad de tecnologías Microsoft .NET en Ecuador</p>
      <div style="margin-top: 1rem; width: 100%;">
        <strong>Tecnologías usadas:</strong>
        <ul style="margin: 0.5rem 0 0 1.2rem; padding: 0;">
          <li>Astro</li>
          <li>CSS</li>
          <li>TypeScript</li>
          <li>JavaScript</li>
        </ul>
      </div>
    </a>
    <a href="https://github.com/DotNet-Ecuador/ecos-volcan" class="proyecto-card" style="text-decoration: none; color: inherit;">
      <h2>Ecos Volcán</h2>
      <p>Videojuego de Acción 2D. Los jugadores exploran las distintas regiones de Ecuador mientras descubren la riqueza cultural y natural del país.</p>
      <div style="margin-top: 1rem; width: 100%;">
        <strong>Tecnologías usadas:</strong>
        <ul style="margin: 0.5rem 0 0 1.2rem; padding: 0;">
          <li>C#</li>
          <li>Rich Text Format</li>
        </ul>
      </div>
    </a>
    <a href="https://github.com/DotNet-Ecuador/api-website-oficial" class="proyecto-card" style="text-decoration: none; color: inherit;">
      <h2>Api Website Oficial</h2>
      <p>API que sirve a la página oficial de la comunidad</p>
      <div style="margin-top: 1rem; width: 100%;">
        <strong>Tecnologías usadas:</strong>
        <ul style="margin: 0.5rem 0 0 1.2rem; padding: 0;">
          <li>C#</li>
          <li>Dockerfile</li>
        </ul>
      </div>
    </a>
    <a href="https://github.com/DotNet-Ecuador/conference-resources" class="proyecto-card" style="text-decoration: none; color: inherit;">
      <h2>Conference Resources</h2>
      <p>Este repositorio contiene recursos de conferencias comunitarias, organizados por evento y tema. Incluye presentaciones, hojas de trabajo, videos y material educativo compartido.</p>
      <div style="margin-top: 1rem; width: 100%;">
       
        
      </div>
    </a>
  </div>
    
 
</Layout>