---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SEO_PAGES_CONFIG } from '../config/seo';

const pageConfig = SEO_PAGES_CONFIG['/mentorias'];
---

<Layout
  title={pageConfig.title}
  description={pageConfig.description}
  keywords={pageConfig.keywords.join(', ')}>

  <!-- Hero Section -->
  <section class="relative pb-20 pt-4 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-primary-900 via-primary-800 to-primary-700"></div>

    <!-- Decorative blobs -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-primary-600/20 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-24 -left-24 w-80 h-80 bg-primary-700/25 rounded-full blur-3xl"></div>
    <div class="absolute top-1/2 right-1/4 w-64 h-64 bg-primary-500/10 rounded-full blur-2xl"></div>

    <div class="relative z-10">
      <div class="container-custom pb-12">
        <Breadcrumbs
          items={[{ name: 'Mentorías', url: '/mentorias' }]}
          variant="dark"
        />

        <!-- Hero text -->
        <div class="text-center mt-10 mb-16">
          <h1 class="text-4xl lg:text-6xl font-bold text-white mb-6 font-heading animate-fade-in">
            Crecer con la guía de<br class="hidden md:block">
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-300 to-purple-300">
              alguien que ya lo vivió
            </span>
          </h1>

          <p class="text-lg lg:text-xl text-white/80 max-w-2xl mx-auto leading-relaxed animate-fade-in">
            Conectamos a desarrolladores de Ecuador con mentores expertos en .NET. Solo aprendizaje genuino.
          </p>

          <!-- Tarjeta highlight "Completamente gratuito" -->
          <div class="inline-flex items-center gap-4 mt-8 bg-emerald-500/15 border border-emerald-400/30 rounded-2xl px-6 py-4 animate-fade-in">
            <div class="flex-shrink-0 w-10 h-10 rounded-full bg-emerald-400/20 border border-emerald-400/40 flex items-center justify-center">
              <svg class="w-5 h-5 text-emerald-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
              </svg>
            </div>
            <div class="text-left">
              <p class="text-emerald-300 font-bold text-base leading-tight">Completamente gratuito</p>
              <p class="text-emerald-100/70 text-sm mt-0.5">Sin costo, sin condiciones, para toda la comunidad</p>
            </div>
          </div>
        </div>

        <!-- Benefits cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16 max-w-5xl mx-auto">
          <div class="benefit-card group">
            <div class="benefit-icon-wrap">
              <!-- Heroicons: academic-cap -->
              <svg class="w-6 h-6 text-primary-300" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 3.741-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5"/>
              </svg>
            </div>
            <h3 class="text-white font-semibold text-lg mb-2">Orientación personalizada</h3>
            <p class="text-white/70 text-sm">Mentores con experiencia real te guiarán según tus objetivos concretos.</p>
          </div>
          <div class="benefit-card group">
            <div class="benefit-icon-wrap">
              <!-- Heroicons: chat-bubble-left-right -->
              <svg class="w-6 h-6 text-primary-300" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 0 1-.825-.242m9.345-8.334a2.126 2.126 0 0 0-.476-.095 48.64 48.64 0 0 0-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0 0 11.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155"/>
              </svg>
            </div>
            <h3 class="text-white font-semibold text-lg mb-2">Respuestas reales</h3>
            <p class="text-white/70 text-sm">Resuelve dudas técnicas, de carrera o arquitectura con alguien que ha pasado por lo mismo.</p>
          </div>
          <div class="benefit-card group">
            <div class="benefit-icon-wrap">
              <!-- Heroicons: user-group -->
              <svg class="w-6 h-6 text-primary-300" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z"/>
              </svg>
            </div>
            <h3 class="text-white font-semibold text-lg mb-2">Red de contactos</h3>
            <p class="text-white/70 text-sm">Forma parte de la comunidad .NET del Ecuador y expande tu red profesional.</p>
          </div>
        </div>

        <!-- Form card -->
        <div class="max-w-2xl mx-auto" id="form-section">
          <div class="bg-white/95 backdrop-blur-sm rounded-3xl shadow-2xl overflow-hidden">
            <!-- Card header -->
            <div class="bg-gradient-to-r from-primary-900 to-primary-700 px-8 py-6">
              <h2 class="text-white font-bold text-2xl font-heading">Solicita tu mentoría</h2>
              <p class="text-white/75 text-sm mt-1">Te contactaremos en menos de 48 horas</p>
            </div>

            <!-- Form -->
            <div id="form-container" class="px-8 py-8">
              <form id="mentoria-form" class="space-y-6" novalidate>

                <!-- Nombre completo -->
                <div class="flex flex-col gap-1">
                  <label for="nombreCompleto" class="text-sm font-semibold text-neutral-700">
                    Nombre completo <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="nombreCompleto"
                    name="nombreCompleto"
                    placeholder="Juan Pérez García"
                    class="field-input"
                    autocomplete="name"
                  />
                  <p class="text-xs text-red-600 mt-0.5 hidden" id="error-nombreCompleto"></p>
                </div>

                <!-- Email -->
                <div class="flex flex-col gap-1">
                  <label for="email" class="text-sm font-semibold text-neutral-700">
                    Correo electrónico <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="juan@ejemplo.com"
                    class="field-input"
                    autocomplete="email"
                  />
                  <p class="text-xs text-red-600 mt-0.5 hidden" id="error-email"></p>
                </div>

                <!-- Teléfono -->
                <div class="flex flex-col gap-1">
                  <label for="telefono" class="text-sm font-semibold text-neutral-700">
                    Número de teléfono <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="tel"
                    id="telefono"
                    name="telefono"
                    placeholder="+593 99 999 9999"
                    class="field-input"
                    autocomplete="tel"
                  />
                  <p class="text-xs text-red-600 mt-0.5 hidden" id="error-telefono"></p>
                </div>

                <!-- Institución — combobox con búsqueda -->
                <div class="flex flex-col gap-1">
                  <label class="text-sm font-semibold text-neutral-700">
                    Institución <span class="text-red-500">*</span>
                  </label>

                  <!-- Hidden field that holds the real value -->
                  <input type="hidden" id="institucionId" name="institucionId" value="" />

                  <div class="relative" id="inst-combobox">
                    <!-- Search input -->
                    <input
                      type="text"
                      id="inst-search"
                      placeholder="Cargando instituciones..."
                      autocomplete="off"
                      role="combobox"
                      aria-haspopup="listbox"
                      aria-expanded="false"
                      aria-controls="inst-listbox"
                      aria-autocomplete="list"
                      class="field-input pr-10 cursor-pointer"
                    />

                    <!-- Icons on the right -->
                    <div class="absolute inset-y-0 right-0 flex items-center pr-3 gap-1">
                      <!-- Clear button (visible only when a value is selected) -->
                      <button
                        type="button"
                        id="inst-clear"
                        class="hidden p-0.5 rounded-full text-neutral-400 hover:text-neutral-600 transition-colors"
                        aria-label="Limpiar selección"
                        tabindex="-1"
                      >
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                      </button>
                      <!-- Chevron -->
                      <span id="inst-chevron" class="pointer-events-none text-neutral-400 transition-transform duration-200">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                      </span>
                    </div>

                    <!-- Dropdown list -->
                    <ul
                      id="inst-listbox"
                      role="listbox"
                      aria-label="Instituciones"
                      class="hidden absolute z-50 mt-1.5 w-full bg-white rounded-xl max-h-56 overflow-y-auto p-1"
                    >
                      <!-- Options injected by JS -->
                    </ul>
                  </div>

                  <p class="text-xs text-red-600 mt-0.5 hidden" id="error-institucionId"></p>
                </div>

                <!-- Otra institución (condicional) -->
                <div class="flex flex-col gap-1 hidden" id="otra-institucion-group">
                  <label for="otraInstitucion" class="text-sm font-semibold text-neutral-700">
                    Nombre de tu institución <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="otraInstitucion"
                    name="otraInstitucion"
                    placeholder="Universidad / Instituto / Empresa"
                    class="field-input"
                  />
                  <p class="text-xs text-red-600 mt-0.5 hidden" id="error-otraInstitucion"></p>
                </div>

                <!-- Tema de consulta -->
                <div class="flex flex-col gap-1">
                  <label for="temaConsulta" class="text-sm font-semibold text-neutral-700">
                    ¿En qué te gustaría recibir mentoría? <span class="text-red-500">*</span>
                  </label>

                  <!-- Pills de sugerencia -->
                  <div class="flex flex-wrap gap-2 mb-3">
                    <button type="button" class="pill" data-text="Quiero aprender C# y .NET desde cero y necesito orientación para empezar">Aprender C# / .NET</button>
                    <button type="button" class="pill" data-text="Necesito ayuda con arquitectura limpia, DDD o patrones de diseño en mis proyectos">Arquitectura y patrones</button>
                    <button type="button" class="pill" data-text="Quiero orientación para avanzar en mi carrera como desarrollador .NET y conseguir mejores oportunidades">Crecimiento profesional</button>
                    <button type="button" class="pill" data-text="Tengo dudas técnicas sobre ASP.NET Core, APIs REST, Entity Framework u otras tecnologías .NET">Dudas técnicas .NET</button>
                    <button type="button" class="pill" data-text="Quiero preparación para entrevistas técnicas en empresas que usan .NET y C#">Preparación para entrevistas</button>
                    <button type="button" class="pill" data-text="Necesito guía para mis proyectos en Azure, AWS o servicios cloud con .NET">Cloud y DevOps</button>
                  </div>

                  <textarea
                    id="temaConsulta"
                    name="temaConsulta"
                    rows="4"
                    placeholder="Describe brevemente el tema en el que necesitas orientación..."
                    class="field-input resize-none"
                  ></textarea>
                  <p class="text-xs text-neutral-400 mt-1">Mínimo 10 caracteres · Máximo 1000</p>
                  <p class="text-xs text-red-600 mt-0.5 hidden" id="error-temaConsulta"></p>
                </div>

                <!-- Submit -->
                <button
                  type="submit"
                  id="submit-btn"
                  class="w-full py-4 px-6 bg-gradient-to-r from-primary-700 to-primary-600 hover:from-primary-600 hover:to-primary-500 text-white font-semibold text-base rounded-2xl transition-all duration-200 flex items-center justify-center gap-3 shadow-lg hover:shadow-primary-hover disabled:opacity-60 disabled:cursor-not-allowed"
                >
                  <span id="btn-text">Solicitar mentoría gratuita</span>
                  <svg id="btn-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                  </svg>
                  <svg id="btn-spinner" class="hidden w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
                  </svg>
                </button>

                <!-- Error global -->
                <div id="global-error" class="hidden bg-red-50 border border-red-200 rounded-xl p-4 text-sm text-red-700"></div>
              </form>
            </div>

            <!-- Success state -->
            <div id="success-container" class="hidden px-8 py-12 text-center">
              <div class="w-20 h-20 rounded-full bg-emerald-100 flex items-center justify-center mx-auto mb-6 success-pop">
                <svg class="w-10 h-10 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <h3 class="text-2xl font-bold text-primary-900 font-heading mb-3">¡Solicitud enviada!</h3>
              <p class="text-neutral-600 mb-2">Hemos recibido tu solicitud de mentoría.</p>
              <p class="text-neutral-600 mb-8">Un mentor de nuestro equipo revisará tu caso y se pondrá en contacto contigo pronto.</p>
              <div class="bg-primary-50 border border-primary-100 rounded-2xl p-4 inline-block text-sm text-primary-700">
                Recuerda que las mentorías de DotNet Ecuador son <strong>completamente gratuitas</strong> 🎓
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

</Layout>

<style>
  .benefit-card {
    background: rgba(255,255,255,0.10);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 1rem;
    padding: 1.5rem;
    backdrop-filter: blur(4px);
    transition: background 0.3s, border-color 0.3s, transform 0.3s;
    animation: slideUp 0.6s ease-out both;
  }
  .benefit-card:hover {
    background: rgba(255,255,255,0.15);
    border-color: rgba(255,255,255,0.25);
    transform: translateY(-4px);
  }
  .benefit-card:nth-child(1) { animation-delay: 0.1s; }
  .benefit-card:nth-child(2) { animation-delay: 0.2s; }
  .benefit-card:nth-child(3) { animation-delay: 0.3s; }

  .benefit-icon-wrap {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.75rem;
    background: rgba(196, 181, 255, 0.12);
    border: 1px solid rgba(196, 181, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .field-input {
    width: 100%;
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    border: 1px solid #d1d5db;
    background: white;
    color: #1f2937;
    font-size: 0.875rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .field-input::placeholder { color: #9ca3af; }
  .field-input:focus {
    outline: none;
    border-color: transparent;
    box-shadow: 0 0 0 2px #4a08b2;
  }
  .field-input.field-error-state {
    border-color: #f87171;
  }
  .field-input.field-error-state:focus {
    box-shadow: 0 0 0 2px #f87171;
  }

  /* ── Dropdown container ── */
  #inst-listbox {
    box-shadow: 0 0 0 1px #e5e7eb, 0 4px 6px -1px rgba(0,0,0,0.06), 0 12px 28px -4px rgba(0,0,0,0.1);
    transform-origin: top center;
    animation: listOpen 0.13s cubic-bezier(0.16,1,0.3,1) both;
  }

  @keyframes listOpen {
    from { opacity: 0; transform: scaleY(0.94) translateY(-4px); }
    to   { opacity: 1; transform: scaleY(1)    translateY(0);    }
  }

  /* Thin scrollbar */
  #inst-listbox::-webkit-scrollbar { width: 5px; }
  #inst-listbox::-webkit-scrollbar-track { background: #f9fafb; border-radius: 99px; }
  #inst-listbox::-webkit-scrollbar-thumb { background: #e5e7eb; border-radius: 99px; }
  #inst-listbox::-webkit-scrollbar-thumb:hover { background: #c4b5ff; }

  /* ── Option items — :global porque se crean dinámicamente con JS ── */
  :global(.inst-option) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.875rem 1rem;
    margin: 2px 4px;
    border-radius: 8px;
    cursor: pointer;
    color: #111827;
    font-size: 0.875rem;
    line-height: 1.4;
    transition: background-color 0.15s, color 0.15s;
    user-select: none;
  }
  :global(.inst-option:hover) {
    background-color: #ede9fe;
    color: #4a08b2;
    cursor: pointer;
  }
  :global(.inst-option.highlighted) {
    background-color: #ede9fe;
    color: #4a08b2;
    cursor: pointer;
  }
  :global(.inst-option.selected) {
    background-color: #ede9fe;
    color: #33057a;
    font-weight: 500;
  }
  :global(.inst-option.selected:hover) {
    background-color: #ddd6fe;
    cursor: pointer;
  }
  :global(.inst-option.no-results) {
    color: #9ca3af;
    cursor: default;
    font-style: italic;
    justify-content: center;
    padding: 1.25rem 1rem;
  }
  :global(.inst-option.no-results:hover) {
    background-color: transparent;
    color: #9ca3af;
  }

  /* Chevron rotation when open */
  #inst-chevron.open { transform: rotate(180deg); }

  .pill {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.375rem 0.75rem;
    border-radius: 9999px;
    border: 1px solid #c4b5ff;
    color: #4a08b2;
    background: #f8f7ff;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
    cursor: pointer;
  }
  .pill:hover {
    background: #ede9ff;
    border-color: #a688ff;
  }
  .pill.active {
    background: #33057a;
    border-color: #33057a;
    color: white;
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes successPop {
    0%   { transform: scale(0); opacity: 0; }
    70%  { transform: scale(1.15); }
    100% { transform: scale(1); opacity: 1; }
  }
  .success-pop {
    animation: successPop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
</style>

<script>
  import { apiService } from '../services/api';
  import type { InstitucionDto } from '../types/api';

  // ── Elements ────────────────────────────────────────────────────────────────

  const form          = document.getElementById('mentoria-form') as HTMLFormElement;
  const formContainer = document.getElementById('form-container')!;
  const successCont   = document.getElementById('success-container')!;
  const submitBtn     = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText       = document.getElementById('btn-text')!;
  const btnIcon       = document.getElementById('btn-icon')!;
  const btnSpinner    = document.getElementById('btn-spinner')!;
  const globalError   = document.getElementById('global-error')!;

  const hiddenInst    = document.getElementById('institucionId') as HTMLInputElement;
  const searchInput   = document.getElementById('inst-search') as HTMLInputElement;
  const listbox       = document.getElementById('inst-listbox')!;
  const clearBtn      = document.getElementById('inst-clear')!;
  const chevron       = document.getElementById('inst-chevron')!;
  const combobox      = document.getElementById('inst-combobox')!;

  const otraGroup     = document.getElementById('otra-institucion-group')!;
  const otraInput     = document.getElementById('otraInstitucion') as HTMLInputElement;

  // ── Combobox state ──────────────────────────────────────────────────────────

  let allOptions: { id: string; label: string }[] = [];
  let selectedId   = '';
  let selectedLabel = '';
  let highlightedIdx = -1;
  let isOpen = false;

  function openList() {
    isOpen = true;
    listbox.classList.remove('hidden');
    searchInput.setAttribute('aria-expanded', 'true');
    chevron.classList.add('open');
    renderOptions(searchInput.value);
  }

  function closeList() {
    isOpen = false;
    listbox.classList.add('hidden');
    searchInput.setAttribute('aria-expanded', 'false');
    chevron.classList.remove('open');
    highlightedIdx = -1;
    // Restore displayed text to selected label (cancel partial search)
    searchInput.value = selectedLabel;
  }

  function selectOption(id: string, label: string) {
    selectedId    = id;
    selectedLabel = label;
    hiddenInst.value  = id;
    searchInput.value = label;
    clearBtn.classList.toggle('hidden', !id);
    closeList();
    clearFieldError('institucionId');
    // Show/hide "otra institución"
    if (id === 'otros') {
      otraGroup.classList.remove('hidden');
      otraInput.required = true;
    } else {
      otraGroup.classList.add('hidden');
      otraInput.required = false;
      otraInput.value = '';
      clearFieldError('otraInstitucion');
    }
  }

  function clearSelection() {
    selectOption('', '');
    searchInput.value = '';
    clearBtn.classList.add('hidden');
    searchInput.focus();
    openList();
  }

  function renderOptions(filter: string) {
    const q = filter.trim().toLowerCase();
    const filtered = q
      ? allOptions.filter(o => o.label.toLowerCase().includes(q))
      : allOptions;

    listbox.innerHTML = '';
    highlightedIdx = -1;

    if (filtered.length === 0) {
      const li = document.createElement('li');
      li.className = 'inst-option no-results';
      li.textContent = 'Sin resultados';
      listbox.appendChild(li);
      return;
    }

    filtered.forEach((opt, i) => {
      const li = document.createElement('li');
      li.role = 'option';
      li.dataset.id    = opt.id;
      li.dataset.label = opt.label;
      li.dataset.idx   = String(i);
      const isSelected = opt.id === selectedId;
      li.className = 'inst-option' + (isSelected ? ' selected' : '');
      li.setAttribute('aria-selected', String(isSelected));

      const checkmark = isSelected
        ? `<svg class="w-4 h-4 flex-shrink-0 text-primary-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>`
        : '';

      if (q) {
        const idx = opt.label.toLowerCase().indexOf(q);
        const labelHtml =
          escHtml(opt.label.slice(0, idx)) +
          `<mark style="background:#ede9ff;color:#4a08b2;border-radius:3px;padding:0 1px">${escHtml(opt.label.slice(idx, idx + q.length))}</mark>` +
          escHtml(opt.label.slice(idx + q.length));
        li.innerHTML = `<span>${labelHtml}</span>${checkmark}`;
      } else {
        li.innerHTML = `<span>${escHtml(opt.label)}</span>${checkmark}`;
      }

      li.addEventListener('mousedown', (e) => {
        e.preventDefault(); // prevent blur before click
        selectOption(opt.id, opt.label);
      });
      listbox.appendChild(li);
    });
  }

  function escHtml(s: string): string {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function highlightItem(idx: number) {
    const items = listbox.querySelectorAll<HTMLLIElement>('.inst-option:not(.no-results)');
    items.forEach(el => el.classList.remove('highlighted'));
    if (idx >= 0 && idx < items.length) {
      items[idx].classList.add('highlighted');
      items[idx].scrollIntoView({ block: 'nearest' });
    }
    highlightedIdx = idx;
  }

  // ── Combobox events ─────────────────────────────────────────────────────────

  searchInput.addEventListener('focus', () => {
    if (!isOpen) openList();
  });

  searchInput.addEventListener('click', () => {
    if (!isOpen) openList();
  });

  searchInput.addEventListener('input', () => {
    if (!isOpen) openList();
    // Typing clears the real selection
    if (searchInput.value !== selectedLabel) {
      selectedId    = '';
      selectedLabel = '';
      hiddenInst.value = '';
      clearBtn.classList.add('hidden');
    }
    renderOptions(searchInput.value);
  });

  searchInput.addEventListener('keydown', (e) => {
    const items = listbox.querySelectorAll<HTMLLIElement>('.inst-option:not(.no-results)');
    const total = items.length;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (!isOpen) { openList(); return; }
      highlightItem(Math.min(highlightedIdx + 1, total - 1));
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      highlightItem(Math.max(highlightedIdx - 1, 0));
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (isOpen && highlightedIdx >= 0 && highlightedIdx < total) {
        const el = items[highlightedIdx];
        selectOption(el.dataset.id!, el.dataset.label!);
      }
    } else if (e.key === 'Escape') {
      closeList();
    } else if (e.key === 'Tab') {
      closeList();
    }
  });

  searchInput.addEventListener('blur', () => {
    // Small delay so mousedown on an option fires first
    setTimeout(() => { if (isOpen) closeList(); }, 120);
  });

  clearBtn.addEventListener('click', clearSelection);

  // Close when clicking outside
  document.addEventListener('click', (e) => {
    if (isOpen && !combobox.contains(e.target as Node)) closeList();
  });

  // ── Load instituciones ──────────────────────────────────────────────────────

  async function loadInstituciones() {
    const res = await apiService.getInstituciones();
    if (res.success && res.data) {
      allOptions = (res.data as InstitucionDto[]).map(i => ({ id: i.id, label: i.nombre }));
      allOptions.push({ id: 'otros', label: 'Otra institución' });
      searchInput.placeholder = 'Busca tu institución...';
      searchInput.disabled = false;
    } else {
      searchInput.placeholder = 'No se pudieron cargar las instituciones';
    }
  }

  searchInput.disabled = true;
  loadInstituciones();

  // ── Suggestion pills ────────────────────────────────────────────────────────

  const textarea = document.getElementById('temaConsulta') as HTMLTextAreaElement;
  document.querySelectorAll<HTMLButtonElement>('.pill').forEach((pill) => {
    pill.addEventListener('click', () => {
      textarea.value = pill.dataset.text ?? '';
      document.querySelectorAll('.pill').forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      textarea.dispatchEvent(new Event('input'));
    });
  });
  textarea.addEventListener('input', () => {
    document.querySelectorAll<HTMLButtonElement>('.pill').forEach((pill) => {
      if (pill.dataset.text !== textarea.value) pill.classList.remove('active');
    });
  });

  // ── Field error helpers ─────────────────────────────────────────────────────

  function showFieldError(field: string, msg: string) {
    const el    = document.getElementById(`error-${field}`);
    const input = document.getElementById(field) as HTMLElement | null;
    if (el)    { el.textContent = msg; el.classList.remove('hidden'); }
    if (input) { input.classList.add('field-error-state'); }
    // For the combobox the visible input has a different id
    if (field === 'institucionId') searchInput.classList.add('field-error-state');
  }

  function clearFieldError(field: string) {
    const el    = document.getElementById(`error-${field}`);
    const input = document.getElementById(field) as HTMLElement | null;
    if (el)    { el.textContent = ''; el.classList.add('hidden'); }
    if (input) { input.classList.remove('field-error-state'); }
    if (field === 'institucionId') searchInput.classList.remove('field-error-state');
  }

  function clearAllErrors() {
    ['nombreCompleto','email','telefono','institucionId','otraInstitucion','temaConsulta'].forEach(clearFieldError);
    globalError.classList.add('hidden');
    globalError.textContent = '';
  }

  // ── Validation ──────────────────────────────────────────────────────────────

  function validate(): boolean {
    clearAllErrors();
    let ok = true;

    const nombre = (document.getElementById('nombreCompleto') as HTMLInputElement).value.trim();
    if (!nombre) { showFieldError('nombreCompleto', 'El nombre completo es requerido.'); ok = false; }
    else if (nombre.length < 3 || nombre.length > 100) { showFieldError('nombreCompleto', 'El nombre debe tener entre 3 y 100 caracteres.'); ok = false; }

    const email = (document.getElementById('email') as HTMLInputElement).value.trim();
    if (!email) { showFieldError('email', 'El correo electrónico es requerido.'); ok = false; }
    else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { showFieldError('email', 'Ingresa un correo electrónico válido.'); ok = false; }

    const telefono = (document.getElementById('telefono') as HTMLInputElement).value.trim();
    if (!telefono) { showFieldError('telefono', 'El número de teléfono es requerido.'); ok = false; }
    else if (!/^\+?[0-9\s\-]{7,15}$/.test(telefono)) { showFieldError('telefono', 'Ingresa un número de teléfono válido.'); ok = false; }

    if (!hiddenInst.value) { showFieldError('institucionId', 'Selecciona tu institución.'); ok = false; }
    else if (hiddenInst.value === 'otros') {
      const otra = otraInput.value.trim();
      if (!otra) { showFieldError('otraInstitucion', 'Especifica el nombre de tu institución.'); ok = false; }
      else if (otra.length > 100) { showFieldError('otraInstitucion', 'El nombre no debe superar 100 caracteres.'); ok = false; }
    }

    const tema = textarea.value.trim();
    if (!tema) { showFieldError('temaConsulta', 'Describe el tema de tu mentoría.'); ok = false; }
    else if (tema.length < 10) { showFieldError('temaConsulta', 'Describe el tema con al menos 10 caracteres.'); ok = false; }
    else if (tema.length > 1000) { showFieldError('temaConsulta', 'El tema no debe superar 1000 caracteres.'); ok = false; }

    return ok;
  }

  // ── Submit ──────────────────────────────────────────────────────────────────

  function setLoading(loading: boolean) {
    submitBtn.disabled = loading;
    btnText.textContent = loading ? 'Enviando...' : 'Solicitar mentoría gratuita';
    btnIcon.classList.toggle('hidden', loading);
    btnSpinner.classList.toggle('hidden', !loading);
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!validate()) return;

    setLoading(true);

    const instId = hiddenInst.value;
    const payload = {
      nombreCompleto: (document.getElementById('nombreCompleto') as HTMLInputElement).value.trim(),
      email:          (document.getElementById('email') as HTMLInputElement).value.trim(),
      telefono:       (document.getElementById('telefono') as HTMLInputElement).value.trim(),
      institucionId:  instId,
      otraInstitucion: instId === 'otros' ? otraInput.value.trim() : undefined,
      temaConsulta:   textarea.value.trim(),
    };

    const res = await apiService.enviarSolicitudMentoria(payload);

    if (res.success) {
      formContainer.classList.add('hidden');
      successCont.classList.remove('hidden');
      window.scrollTo({ top: (document.getElementById('form-section') as HTMLElement).offsetTop - 80, behavior: 'smooth' });
    } else {
      setLoading(false);
      globalError.textContent = res.message ?? 'Ocurrió un error al enviar tu solicitud. Por favor intenta de nuevo.';
      globalError.classList.remove('hidden');
    }
  });
</script>
