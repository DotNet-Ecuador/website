---
import { EVENT_SLUGS } from '../../data/events';
import logo from '../../assets/dotnet_logo.png';
import '../../assets/styles/base.css';

export function getStaticPaths() {
  return EVENT_SLUGS.map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Registro — DotNet Ecuador</title>
  <meta name="description" content="Regístrate en este evento de DotNet Ecuador" />
  <meta name="robots" content="noindex" />
  <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:wght@400;500;600&display=swap"
    rel="stylesheet"
    media="print"
    onload="this.media='all'"
  />
</head>
<body class="font-dmsans bg-neutral-900 overflow-x-hidden">

  <!-- ── Shell: left branding + right form ── -->
  <div class="reg-shell">

    <!-- ── LEFT PANEL ── -->
    <aside class="reg-left" aria-hidden="true">
      <div class="reg-left__inner">
        <a href="/eventos" class="reg-logo" aria-label="DotNet Ecuador — volver a eventos">
          <img src={logo.src} alt="DotNet Ecuador" class="reg-logo__img" />
        </a>

        <div class="reg-event-info">
          <p class="reg-event-info__type" id="left-type">&nbsp;</p>
          <h2 class="reg-event-info__title" id="left-title">&nbsp;</h2>
          <ul class="reg-event-info__meta" id="left-meta"></ul>
        </div>

        <p class="reg-left__tagline">Registro seguro · Confirmación por email</p>
      </div>
    </aside>

    <!-- ── RIGHT PANEL ── -->
    <main class="reg-right" id="reg-main">

      <!-- Mobile-only compact header -->
      <div class="reg-mobile-header">
        <a href="/eventos" class="reg-mobile-header__logo">
          <img src={logo.src} alt="DotNet Ecuador" height="28" />
        </a>
        <span class="reg-mobile-header__event" id="mobile-event-title"></span>
      </div>

      <!-- Progress bar -->
      <div class="reg-progress" role="progressbar" aria-valuenow={1} aria-valuemin={1} aria-valuemax={3} aria-label="Progreso del registro">
        <div class="reg-progress__bar" id="reg-progress-bar" style="width: 33.33%"></div>
      </div>

      <!-- Step counter -->
      <div class="reg-step-label" id="reg-step-label" aria-live="polite">Paso 1 de 3</div>

      <!-- Resume banner (shown when existing registration detected) -->
      <div class="resume-banner hidden" id="resume-banner" role="status">
        <div class="resume-banner__icon" id="resume-banner-icon" aria-hidden="true"></div>
        <div class="resume-banner__content">
          <p class="resume-banner__title" id="resume-banner-title"></p>
          <p class="resume-banner__body" id="resume-banner-body"></p>
        </div>
        <div class="resume-banner__actions" id="resume-banner-actions"></div>
      </div>

      <!-- Steps container -->
      <div class="reg-steps" id="reg-steps">

        <!-- ── STEP 1: Personal data ── -->
        <div class="reg-step reg-step--active" id="step-1" role="group" aria-labelledby="step1-title">
          <div class="reg-step__content">
            <h1 class="reg-step__title" id="step1-title">Tus datos</h1>
            <p class="reg-step__subtitle">Completa la información para reservar tu lugar.</p>

            <a href={`/mi-ticket/${slug}`} class="already-registered-link">
              ¿Ya tienes ticket? Ver mi entrada →
            </a>

            <form id="form-step1" class="reg-form" novalidate>
              <div class="reg-form__row reg-form__row--2">
                <div class="reg-field">
                  <label for="email" class="reg-label">Email <span aria-hidden="true">*</span></label>
                  <input
                    type="email" id="email" name="email"
                    placeholder="tu@correo.com"
                    autocomplete="email"
                    required maxlength="100"
                    class="reg-input"
                  />
                  <span class="reg-error" id="err-email"></span>
                </div>
                <div class="reg-field">
                  <label for="nombre" class="reg-label">Nombre completo <span aria-hidden="true">*</span></label>
                  <input
                    type="text" id="nombre" name="nombre"
                    placeholder="Ej: Carlos Mendoza"
                    autocomplete="name"
                    required minlength="2" maxlength="80"
                    class="reg-input"
                  />
                  <span class="reg-error" id="err-nombre"></span>
                </div>
              </div>

              <div class="reg-field">
                <label for="telefono" class="reg-label">Teléfono <span aria-hidden="true">*</span></label>
                <input
                  type="tel" id="telefono" name="telefono"
                  placeholder="+593 99 000 0000"
                  autocomplete="tel"
                  required maxlength="20"
                  class="reg-input reg-input--half"
                />
                <span class="reg-error" id="err-telefono"></span>
              </div>

              <div class="reg-form__row reg-form__row--2">
                <div class="reg-field">
                  <label for="empresa" class="reg-label">Empresa <span class="reg-label__optional">(opcional)</span></label>
                  <input
                    type="text" id="empresa" name="empresa"
                    placeholder="Tu empresa o proyecto"
                    autocomplete="organization"
                    maxlength="80"
                    class="reg-input"
                  />
                </div>
                <div class="reg-field">
                  <label for="cargo" class="reg-label">Cargo <span class="reg-label__optional">(opcional)</span></label>
                  <input
                    type="text" id="cargo" name="cargo"
                    placeholder="Ej: Senior Developer"
                    autocomplete="organization-title"
                    maxlength="80"
                    class="reg-input"
                  />
                </div>
              </div>

              <label class="reg-checkbox">
                <input type="checkbox" id="aceptaMarketing" name="aceptaMarketing" />
                <span class="reg-checkbox__box"></span>
                <span class="reg-checkbox__label">
                  Acepto recibir comunicaciones de DotNet Ecuador (meetups, noticias, recursos)
                </span>
              </label>
            </form>
          </div>

          <div class="reg-step__footer">
            <div></div>
            <button type="button" class="reg-btn reg-btn--primary" id="btn-next-1">
              Continuar
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </button>
          </div>
        </div>

        <!-- ── STEP 2: Payment ── -->
        <div class="reg-step" id="step-2" role="group" aria-labelledby="step2-title">
          <div class="reg-step__content">
            <h1 class="reg-step__title" id="step2-title">Realiza tu pago</h1>
            <p class="reg-step__subtitle">Transfiere exactamente el monto indicado y sube tu comprobante para confirmar el pago.</p>

            <!-- Bank details card -->
            <div class="pay-card" id="pay-card">
              <div class="pay-card__header">
                <span class="pay-card__label">Datos bancarios</span>
                <button type="button" class="pay-card__copy" id="btn-copy" aria-label="Copiar datos bancarios">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                  <span id="copy-label">Copiar datos</span>
                </button>
              </div>
              <div class="pay-card__body">
                <div class="pay-row">
                  <span class="pay-row__key">Banco</span>
                  <span class="pay-row__val" id="pay-banco">—</span>
                  <span></span>
                </div>
                <div class="pay-row">
                  <span class="pay-row__key">Tipo de cuenta</span>
                  <span class="pay-row__val" id="pay-tipo">—</span>
                  <span></span>
                </div>
                <div class="pay-row">
                  <span class="pay-row__key">Número de cuenta</span>
                  <span class="pay-row__val pay-row__val--mono" id="pay-numero">—</span>
                  <button type="button" class="pay-copy-num" id="btn-copy-num" aria-label="Copiar número de cuenta">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                    <span id="copy-num-label">Copiar</span>
                  </button>
                </div>
                <div class="pay-row">
                  <span class="pay-row__key">Titular</span>
                  <span class="pay-row__val" id="pay-titular">—</span>
                  <span></span>
                </div>
                <div class="pay-row pay-row--highlight">
                  <span class="pay-row__key">Monto exacto</span>
                  <span class="pay-row__val pay-row__val--amount" id="pay-monto">—</span>
                  <span></span>
                </div>
              </div>
            </div>

            <!-- Proof upload -->
            <form id="form-step2" class="reg-form" novalidate>
              <div class="reg-field">
                <label for="comprobante" class="reg-label">
                  Comprobante de pago <span aria-hidden="true">*</span>
                </label>
                <label class="upload-zone" id="upload-zone" for="comprobante">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="upload-zone__icon" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                  <span class="upload-zone__text" id="upload-text">
                    <strong>Seleccionar archivo</strong> o arrastrarlo aquí
                  </span>
                  <span class="upload-zone__hint">JPG, PNG o PDF · máx. 5 MB</span>
                  <input
                    type="file" id="comprobante" name="comprobante"
                    accept=".jpg,.jpeg,.png,.pdf"
                    class="sr-only"
                  />
                </label>
                <span class="reg-error" id="err-comprobante"></span>
              </div>
            </form>
          </div>

          <div class="reg-step__footer">
            <button type="button" class="reg-btn reg-btn--ghost" id="btn-back-2">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
              Atrás
            </button>
            <button type="button" class="reg-btn reg-btn--primary" id="btn-next-2">
              <span id="btn-next-2-label">He realizado el pago</span>
              <span id="btn-next-2-spinner" class="hidden">
                <svg class="reg-spin" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
              </span>
            </button>
          </div>
        </div>

        <!-- ── STEP 3: Confirmation ── -->
        <div class="reg-step" id="step-3" role="group" aria-labelledby="step3-title">
          <div class="reg-step__content reg-step__content--center">
            <div class="confirm-icon">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <h1 class="reg-step__title" id="step3-title">¡Registro recibido!</h1>
            <p class="reg-step__subtitle">
              Revisaremos tu comprobante a la brevedad.<br/>
              Si todo está en orden, recibirás tu QR de entrada por email.
            </p>

            <div class="confirm-code">
              <p class="confirm-code__label">Tu código de registro</p>
              <canvas id="confirm-qr-canvas" style="display:block;margin:0.75rem auto 0.25rem;border-radius:0.5rem;"></canvas>
              <p class="confirm-code__value" id="confirm-id-corto">—</p>
            </div>

            <p class="confirm-note">
              Recibirás este QR en tu correo. Preséntalo en la entrada del evento.
            </p>
          </div>

          <div class="reg-step__footer reg-step__footer--center">
            <a href="/eventos" class="reg-btn reg-btn--ghost">
              Ver más eventos
            </a>
          </div>
        </div>

      </div><!-- /.reg-steps -->

      <!-- Error toast -->
      <div class="reg-toast reg-toast--error" id="reg-toast" role="alert" aria-live="assertive">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <span id="reg-toast-msg"></span>
      </div>

    </main><!-- /.reg-right -->
  </div><!-- /.reg-shell -->

  <!-- WhatsApp FAB (same as Layout.astro) -->
  <a
    href="https://wa.me/593984857062"
    target="_blank"
    rel="noopener noreferrer"
    class="whatsapp-fab"
    aria-label="Contáctanos por WhatsApp"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="28" height="28">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
  </a>

  <script>
    import { apiService } from '../../services/api';
    import confetti from 'canvas-confetti';
    import QRCode from 'qrcode';

    // ── State ──────────────────────────────────────────────────────────────
    let currentStep = 1;
    let registroId: string | null = null;
    let sessionToken: string | null = null;
    const eventSlug = window.location.pathname.split('/').filter(Boolean).pop()!;
    const LS_KEY = `dotnet_reg_${eventSlug}`;

    type StoredReg = { registroId: string; sessionToken: string; idCorto: string; monto: number; email: string; nombre?: string; telefono?: string; empresa?: string; cargo?: string; comprobanteEnviado?: boolean };

    function saveRegistration(data: StoredReg) {
      localStorage.setItem(LS_KEY, JSON.stringify(data));
    }

    function clearRegistration() {
      localStorage.removeItem(LS_KEY);
    }

    function loadRegistration(): StoredReg | null {
      try {
        const raw = localStorage.getItem(LS_KEY);
        return raw ? JSON.parse(raw) : null;
      } catch {
        clearRegistration();
        return null;
      }
    }

    async function populateStep2(idCorto: string, monto: number) {
      document.getElementById('pay-monto')!.textContent = `$${monto.toFixed(2)}`;
      const cuentaRes = await apiService.getDatosCuenta();
      if (cuentaRes.success && cuentaRes.data) {
        const dt = cuentaRes.data;
        document.getElementById('pay-banco')!.textContent   = dt.banco;
        document.getElementById('pay-tipo')!.textContent    = dt.tipoCuenta;
        document.getElementById('pay-numero')!.textContent  = dt.numeroCuenta;
        document.getElementById('pay-titular')!.textContent = dt.titular;
      }
    }

    async function resumeToStep2(stored: StoredReg) {
      registroId   = stored.registroId;
      sessionToken = stored.sessionToken;
      sessionStorage.setItem('reg_session', JSON.stringify({ registroId: stored.registroId, sessionToken: stored.sessionToken, idCorto: stored.idCorto }));
      // Pre-fill step 1 so going back shows the original data
      fEmail.value    = stored.email    ?? '';
      fNombre.value   = stored.nombre   ?? '';
      fTelefono.value = stored.telefono ?? '';
      fEmpresa.value  = stored.empresa  ?? '';
      fCargo.value    = stored.cargo    ?? '';
      await populateStep2(stored.idCorto, stored.monto);
      goToStep(2);
    }

    async function showTicketScreen(stored: StoredReg, confirmed: boolean) {
      document.getElementById('reg-steps')!.classList.add('hidden');
      document.querySelector('.reg-progress')?.classList.add('hidden');
      document.getElementById('reg-step-label')!.classList.add('hidden');

      const main = document.getElementById('reg-main')!;
      const canvas = document.createElement('canvas');
      await QRCode.toCanvas(canvas, stored.idCorto, { width: 260, margin: 2, color: { dark: '#1f085a', light: '#ffffff' } });

      const screen = document.createElement('div');
      screen.className = 'ticket-screen';
      screen.innerHTML = confirmed
        ? `<div class="ticket-screen__icon ticket-screen__icon--success">
             <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
           </div>
           <h2 class="ticket-screen__title">¡Tienes tu entrada!</h2>
           <p class="ticket-screen__subtitle">Tu pago fue confirmado. Presenta este QR en la entrada del evento.</p>`
        : `<div class="ticket-screen__icon ticket-screen__icon--pending">
             <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
           </div>
           <h2 class="ticket-screen__title">Comprobante enviado</h2>
           <p class="ticket-screen__subtitle">Estamos verificando tu pago. Recibirás confirmación a la brevedad por email.</p>`;

      const qrWrap = document.createElement('div');
      qrWrap.className = 'ticket-screen__qr';
      qrWrap.appendChild(canvas);
      const code = document.createElement('p');
      code.className = 'ticket-screen__code';
      code.textContent = stored.idCorto;
      qrWrap.appendChild(code);
      screen.appendChild(qrWrap);

      const footer = document.createElement('div');
      footer.className = 'ticket-screen__footer';
      footer.innerHTML = `<a href="/eventos" class="reg-btn reg-btn--ghost">Ver más eventos</a>`;
      screen.appendChild(footer);

      main.appendChild(screen);

      // Fire confetti
      confetti({ particleCount: 120, spread: 80, origin: { y: 0.6 }, colors: ['#1A3FE8', '#7B2FBE', '#C2185B', '#ffffff'] });
      setTimeout(() => confetti({ particleCount: 60, spread: 120, origin: { y: 0.5 }, colors: ['#1A3FE8', '#7B2FBE', '#C2185B'] }), 300);
    }

    async function checkExistingRegistration() {
      const stored = loadRegistration();
      if (!stored) return;

      const estadoRes = await apiService.getEstadoRegistro(stored.registroId);
      if (!estadoRes.success || !estadoRes.data) {
        clearRegistration();
        return;
      }

      const estado = estadoRes.data.estado;
      if (estado === 'pendiente' && !stored.comprobanteEnviado) {
        resumeToStep2(stored);
      } else if (estado === 'pendiente' && stored.comprobanteEnviado) {
        showTicketScreen(stored, false);
      } else if (estado === 'pagado') {
        showTicketScreen(stored, true);
      } else {
        clearRegistration();
      }
    }

    checkExistingRegistration();

    // ── Populate left panel from API ───────────────────────────────────────
    const MONTHS_ES = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
    const TYPE_LABEL: Record<string,string> = { taller:'Taller', charla:'Charla', meetup:'Meetup', conference:'Conferencia', workshop:'Workshop', webinar:'Webinar', panel:'Panel' };
    const FORMAT_LABEL: Record<string,string> = { presencial:'Presencial', virtual:'Virtual', hibrido:'Híbrido' };

    function parseFechaShort(iso: string): string {
      const d = new Date(iso);
      const ect = new Date(d.getTime() - 5 * 60 * 60 * 1000);
      return `${ect.getUTCDate()} ${MONTHS_ES[ect.getUTCMonth()]} ${ect.getUTCFullYear()}, ${String(ect.getUTCHours()).padStart(2,'0')}:${String(ect.getUTCMinutes()).padStart(2,'0')}`;
    }

    (async () => {
      const result = await apiService.getEvento(eventSlug);
      if (!result.success || !result.data) return;
      const e = result.data;

      document.title = `Registro — ${e.nombre} | DotNet Ecuador`;

      const leftType = document.getElementById('left-type')!;
      const leftTitle = document.getElementById('left-title')!;
      const leftMeta = document.getElementById('left-meta')!;
      const mobileTitle = document.getElementById('mobile-event-title');

      leftType.textContent = [TYPE_LABEL[e.tipo]??e.tipo, FORMAT_LABEL[e.formato]??e.formato].filter(Boolean).join(' · ') || '';
      leftTitle.textContent = e.nombre;
      if (mobileTitle) mobileTitle.textContent = e.nombre;

      const liStyle = 'style="display:flex;align-items:center;gap:0.5rem;font-size:0.9rem;font-weight:600;color:#fff;text-shadow:0 1px 3px rgba(0,0,0,0.4);"';
      if (e.fechaEvento) {
        leftMeta.insertAdjacentHTML('beforeend', `<li ${liStyle}><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>${parseFechaShort(e.fechaEvento)}</li>`);
      }
      if (e.lugar) {
        leftMeta.insertAdjacentHTML('beforeend', `<li ${liStyle}><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>${e.lugar}</li>`);
      }
      if (e.precio != null) {
        leftMeta.insertAdjacentHTML('beforeend', `<li ${liStyle}><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>${e.precio === 0 ? 'Gratis' : `$${e.precio}`}</li>`);
      }
    })();

    // ── DOM refs ───────────────────────────────────────────────────────────
    const progressBar   = document.getElementById('reg-progress-bar') as HTMLDivElement;
    const stepLabel     = document.getElementById('reg-step-label') as HTMLElement;
    const steps         = [1, 2, 3].map(n => document.getElementById(`step-${n}`) as HTMLDivElement);
    const toast         = document.getElementById('reg-toast') as HTMLDivElement;
    const toastMsg      = document.getElementById('reg-toast-msg') as HTMLSpanElement;

    // Step 1 inputs
    const fNombre   = document.getElementById('nombre')   as HTMLInputElement;
    const fEmail    = document.getElementById('email')    as HTMLInputElement;
    const fEmpresa  = document.getElementById('empresa')  as HTMLInputElement;
    const fCargo    = document.getElementById('cargo')    as HTMLInputElement;
    const fTelefono = document.getElementById('telefono') as HTMLInputElement;
    const fMarketing = document.getElementById('aceptaMarketing') as HTMLInputElement;

    // Step 2 inputs
    const fComprobante = document.getElementById('comprobante') as HTMLInputElement;
    const uploadZone   = document.getElementById('upload-zone')    as HTMLLabelElement;
    const uploadText   = document.getElementById('upload-text')    as HTMLSpanElement;

    // ── Helpers ────────────────────────────────────────────────────────────
    function showToast(msg: string) {
      toastMsg.textContent = msg;
      toast.classList.add('reg-toast--visible');
      setTimeout(() => toast.classList.remove('reg-toast--visible'), 4500);
    }

    function setError(id: string, msg: string) {
      const el = document.getElementById(id);
      if (el) el.textContent = msg;
    }

    function clearErrors() {
      document.querySelectorAll('.reg-error').forEach(el => (el.textContent = ''));
    }

    function goToStep(next: number) {
      const prev = currentStep;
      steps[prev - 1].classList.remove('reg-step--active');
      steps[prev - 1].classList.add(next > prev ? 'reg-step--leaving-left' : 'reg-step--leaving-right');

      setTimeout(() => {
        steps[prev - 1].classList.remove('reg-step--leaving-left', 'reg-step--leaving-right');
        steps[next - 1].classList.add(next > prev ? 'reg-step--entering-right' : 'reg-step--entering-left');

        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            steps[next - 1].classList.remove('reg-step--entering-right', 'reg-step--entering-left');
            steps[next - 1].classList.add('reg-step--active');
          });
        });

        currentStep = next;
        progressBar.style.width = `${(next / 3) * 100}%`;
        stepLabel.textContent = `Paso ${next} de 3`;
        document.querySelector('.reg-right')?.scrollTo({ top: 0, behavior: 'smooth' });
      }, 280);
    }

    // ── Email blur: check for existing registration (cross-device) ────────
    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    fEmail.addEventListener('blur', async () => {
      const email = fEmail.value.trim();
      if (!emailRe.test(email)) return;
      // Already handled by localStorage on page load — only call API if not found locally
      const stored = loadRegistration();
      if (stored && stored.email === email) return;
      const recovered = await apiService.recuperarRegistro(email, eventSlug);
      if (!recovered.success || !recovered.data) return;
      const d = recovered.data;
      const storedRec: StoredReg = {
        registroId:   d.registroId,
        sessionToken: d.sessionToken ?? '',
        idCorto:      d.idCorto,
        monto:        d.monto,
        email,
      };
      saveRegistration(storedRec);
      if (d.estado === 'pendiente') {
        resumeToStep2(storedRec);
      } else {
        showTicketScreen(storedRec, false);
      }
    });

    // ── Validation step 1 ─────────────────────────────────────────────────
    function validateStep1(): boolean {
      clearErrors();
      let ok = true;

      if (!fNombre.value.trim() || fNombre.value.trim().length < 2) {
        setError('err-nombre', 'Ingresa tu nombre completo (mínimo 2 caracteres).');
        ok = false;
      }
      if (!emailRe.test(fEmail.value.trim())) {
        setError('err-email', 'Ingresa un correo electrónico válido.');
        ok = false;
      }
      if (!fTelefono.value.trim()) {
        setError('err-telefono', 'El teléfono es obligatorio.');
        ok = false;
      }
      return ok;
    }

    // ── Step 1 → register & go to step 2 ──────────────────────────────────
    document.getElementById('btn-next-1')!.addEventListener('click', async () => {
      if (!validateStep1()) return;

      const btn = document.getElementById('btn-next-1') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = 'Procesando…';

      const result = await apiService.crearRegistro({
        eventoSlug: eventSlug,
        nombre: fNombre.value.trim(),
        email: fEmail.value.trim(),
        empresa: fEmpresa.value.trim() || undefined,
        cargo: fCargo.value.trim() || undefined,
        telefono: fTelefono.value.trim(),
        aceptaMarketing: fMarketing.checked,
      });

      btn.disabled = false;
      btn.innerHTML = 'Continuar <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>';

      if (!result.success || !result.data) {
        const email = fEmail.value.trim();
        const stored = loadRegistration();
        if (stored && stored.email === email) {
          resumeToStep2(stored);
          return;
        }
        // Fallback: try to recover via API (cross-device or cleared localStorage)
        const recovered = await apiService.recuperarRegistro(email, eventSlug);
        if (recovered.success && recovered.data) {
          const d = recovered.data;
          const storedRec: StoredReg = {
            registroId:   d.registroId,
            sessionToken: d.sessionToken ?? '',
            idCorto:      d.idCorto,
            monto:        d.monto,
            email,
          };
          saveRegistration(storedRec);
          if (d.estado === 'pendiente') {
            resumeToStep2(storedRec);
          } else {
            showTicketScreen(storedRec, false);
          }
          return;
        }
        showToast(result.message ?? 'Error al procesar el registro. Intenta nuevamente.');
        return;
      }

      const data = result.data;
      registroId   = data.registroId;
      sessionToken = data.sessionToken;

      const stored: StoredReg = {
        registroId:   data.registroId,
        sessionToken: data.sessionToken,
        idCorto:      data.idCorto,
        monto:        data.monto,
        email:        fEmail.value.trim(),
        nombre:       fNombre.value.trim(),
        telefono:     fTelefono.value.trim(),
        empresa:      fEmpresa.value.trim(),
        cargo:        fCargo.value.trim(),
      };
      saveRegistration(stored);
      sessionStorage.setItem('reg_session', JSON.stringify({ registroId: data.registroId, sessionToken: data.sessionToken, idCorto: data.idCorto }));

      await populateStep2(data.idCorto, data.monto);
      goToStep(2);
    });

    // ── Copy payment data ─────────────────────────────────────────────────
    document.getElementById('btn-copy')!.addEventListener('click', () => {
      const banco   = document.getElementById('pay-banco')!.textContent;
      const tipo    = document.getElementById('pay-tipo')!.textContent;
      const numero  = document.getElementById('pay-numero')!.textContent;
      const titular = document.getElementById('pay-titular')!.textContent;
      const monto   = document.getElementById('pay-monto')!.textContent;

      const text = `Banco: ${banco}\nTipo de cuenta: ${tipo}\nNúmero: ${numero}\nTitular: ${titular}\nMonto: ${monto}`;
      navigator.clipboard.writeText(text).then(() => {
        const label = document.getElementById('copy-label')!;
        label.textContent = '¡Copiado!';
        document.getElementById('btn-copy')!.classList.add('pay-card__copy--success');
        setTimeout(() => {
          label.textContent = 'Copiar datos';
          document.getElementById('btn-copy')!.classList.remove('pay-card__copy--success');
        }, 2000);
      });
    });

    // ── Copy account number ────────────────────────────────────────────────
    document.getElementById('btn-copy-num')!.addEventListener('click', () => {
      const numero = document.getElementById('pay-numero')!.textContent ?? '';
      navigator.clipboard.writeText(numero).then(() => {
        const label = document.getElementById('copy-num-label')!;
        const btn = document.getElementById('btn-copy-num')!;
        label.textContent = '¡Copiado!';
        btn.classList.add('pay-copy-num--success');
        setTimeout(() => {
          label.textContent = 'Copiar';
          btn.classList.remove('pay-copy-num--success');
        }, 2000);
      });
    });

    // ── File upload feedback ───────────────────────────────────────────────
    fComprobante.addEventListener('change', () => {
      const file = fComprobante.files?.[0];
      if (!file) return;

      if (file.size > 5 * 1024 * 1024) {
        setError('err-comprobante', 'El archivo excede los 5 MB permitidos.');
        fComprobante.value = '';
        return;
      }
      setError('err-comprobante', '');
      uploadText.innerHTML = `<strong>${file.name}</strong>`;
      uploadZone.classList.add('upload-zone--has-file');
    });

    // Drag-and-drop
    uploadZone.addEventListener('dragover', e => { e.preventDefault(); uploadZone.classList.add('upload-zone--drag'); });
    uploadZone.addEventListener('dragleave', () => uploadZone.classList.remove('upload-zone--drag'));
    uploadZone.addEventListener('drop', e => {
      e.preventDefault();
      uploadZone.classList.remove('upload-zone--drag');
      const file = e.dataTransfer?.files[0];
      if (file) {
        const dt = new DataTransfer();
        dt.items.add(file);
        fComprobante.files = dt.files;
        fComprobante.dispatchEvent(new Event('change'));
      }
    });

    // ── Back step 2 → 1 ───────────────────────────────────────────────────
    document.getElementById('btn-back-2')!.addEventListener('click', () => goToStep(1));

    // ── Validation step 2 ─────────────────────────────────────────────────
    function validateStep2(): boolean {
      clearErrors();
      if (!fComprobante.files?.[0]) {
        setError('err-comprobante', 'Adjunta el comprobante de pago para continuar.');
        return false;
      }
      return true;
    }

    // ── Step 2 → upload & go to step 3 ────────────────────────────────────
    document.getElementById('btn-next-2')!.addEventListener('click', async () => {
      if (!validateStep2()) return;

      // Restore from sessionStorage in case of page refresh
      if (!registroId || !sessionToken) {
        const session = JSON.parse(sessionStorage.getItem('reg_session') ?? 'null');
        if (session) { registroId = session.registroId; sessionToken = session.sessionToken; }
      }

      if (!registroId || !sessionToken) {
        showToast('Sesión expirada. Por favor, inicia el registro nuevamente.');
        goToStep(1);
        return;
      }

      const btnLabel   = document.getElementById('btn-next-2-label')!;
      const btnSpinner = document.getElementById('btn-next-2-spinner')!;
      const btn        = document.getElementById('btn-next-2') as HTMLButtonElement;
      btn.disabled     = true;
      btnLabel.classList.add('hidden');
      btnSpinner.classList.remove('hidden');

      const archivo = fComprobante.files?.[0] ?? null;
      const result  = await apiService.subirComprobante(
        registroId,
        '',
        archivo,
        sessionToken
      );

      btn.disabled = false;
      btnLabel.classList.remove('hidden');
      btnSpinner.classList.add('hidden');

      if (!result.success) {
        showToast(result.message ?? 'Error al enviar el comprobante. Intenta nuevamente.');
        return;
      }

      // Show confirmation
      const idCorto = (JSON.parse(sessionStorage.getItem('reg_session') ?? 'null')?.idCorto) ?? '—';
      document.getElementById('confirm-id-corto')!.textContent = idCorto;

      // Generate QR code
      const canvas = document.getElementById('confirm-qr-canvas') as HTMLCanvasElement;
      await QRCode.toCanvas(canvas, idCorto, { width: 260, margin: 2, color: { dark: '#1f085a', light: '#ffffff' } });

      // Mark comprobante as sent so returning users see ticket screen instead of step 2
      const existingReg = loadRegistration();
      if (existingReg) saveRegistration({ ...existingReg, comprobanteEnviado: true });
      sessionStorage.removeItem('reg_session');

      goToStep(3);

      // Fire confetti after transition
      setTimeout(() => {
        confetti({ particleCount: 120, spread: 80, origin: { y: 0.6 }, colors: ['#1A3FE8', '#7B2FBE', '#C2185B', '#ffffff'] });
        setTimeout(() => confetti({ particleCount: 60, spread: 120, origin: { y: 0.5 }, colors: ['#1A3FE8', '#7B2FBE', '#C2185B'] }), 300);
      }, 350);
    });
  </script>

</body>
</html>

<style>
  /* ── Layout shell ─────────────────────────────────────────────────────── */
  .reg-shell {
    display: grid;
    grid-template-columns: 380px 1fr;
    min-height: 100dvh;
  }

  /* ── Left panel ───────────────────────────────────────────────────────── */
  .reg-left {
    background: linear-gradient(135deg, #1A3FE8 0%, #7B2FBE 55%, #C2185B 100%);
