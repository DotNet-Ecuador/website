    transition: opacity 0.28s ease, transform 0.28s ease;
  }
  .reg-step--active {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(0);
    position: relative;
  }
  .reg-step--leaving-left {
    opacity: 0;
    transform: translateX(-48px);
    pointer-events: none;
  }
  .reg-step--leaving-right {
    opacity: 0;
    transform: translateX(48px);
    pointer-events: none;
  }
  .reg-step--entering-right {
    opacity: 0;
    transform: translateX(48px);
  }
  .reg-step--entering-left {
    opacity: 0;
    transform: translateX(-48px);
  }

  .reg-step__content {
    flex: 1;
    padding: 2.5rem 2.5rem 1rem;
    overflow-y: auto;
  }
  .reg-step__content--center {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    justify-content: center;
    padding-top: 4rem;
  }

  .reg-step__title {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 1.875rem;
    color: #100123;
    margin-bottom: 0.5rem;
    line-height: 1.2;
  }
  .reg-step__subtitle {
    font-size: 0.9375rem;
    color: #52525b;
