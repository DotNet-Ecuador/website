  }
  .already-registered-link:hover { color: #7B2FBE; text-decoration: underline; }

  .reg-step__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 2.5rem 2rem;
    gap: 1rem;
    border-top: 1px solid #ede9ff;
    background: #f8f7ff;
  }
  .reg-step__footer--center { justify-content: center; }

  /* ── Form ─────────────────────────────────────────────────────────────── */
  .reg-form { display: flex; flex-direction: column; gap: 1.25rem; }
  .reg-form__row { display: grid; gap: 1rem; }
  .reg-form__row--2 { grid-template-columns: 1fr 1fr; }

  .reg-field { display: flex; flex-direction: column; gap: 0.375rem; }

  .reg-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #1d0448;
    letter-spacing: 0.01em;
  }
  .reg-label__optional { font-weight: 400; color: #71717a; font-size: 0.75rem; }

  .reg-input {
    padding: 0.75rem 1rem;
    background: #fff;
    border: 1.5px solid #c4b5ff;
    border-radius: 0.75rem;
    font-size: 0.9375rem;
    color: #100123;
    font-family: 'DM Sans', sans-serif;
    transition: border-color 0.2s, box-shadow 0.2s;
    width: 100%;
  }
  .reg-input::placeholder { color: #a1a1aa; }
  .reg-input:focus {
    outline: none;
    border-color: #8b5dff;
    box-shadow: 0 0 0 3px rgba(139,93,255,0.12);
  }
  .reg-input--half { max-width: 280px; }

  .reg-error {
    font-size: 0.75rem;
    color: #dc2626;
    min-height: 1rem;
    display: block;
  }

  .reg-checkbox {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    cursor: pointer;
    padding-top: 0.25rem;
  }
  .reg-checkbox input { position: absolute; opacity: 0; width: 0; height: 0; }
  .reg-checkbox__box {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border: 2px solid #c4b5ff;
    border-radius: 5px;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s, border-color 0.15s;
    margin-top: 1px;
  }
  .reg-checkbox input:checked + .reg-checkbox__box {
    background: #4a08b2;
    border-color: #4a08b2;
  }
  .reg-checkbox input:checked + .reg-checkbox__box::after {
    content: '';
    display: block;
    width: 11px;
    height: 7px;
    border-left: 2px solid #fff;
    border-bottom: 2px solid #fff;
    transform: rotate(-45deg) translateY(-2px);
  }
  .reg-checkbox__label { font-size: 0.875rem; color: #3f3f46; line-height: 1.5; }

  /* ── Buttons ──────────────────────────────────────────────────────────── */
  :global(.reg-btn) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.75rem;
    border-radius: 9999px;
    font-size: 0.9375rem;
    font-weight: 600;
    font-family: 'DM Sans', sans-serif;
    cursor: pointer;
    border: none;
    transition: background 0.18s, color 0.18s, opacity 0.18s, transform 0.1s;
    min-height: 48px;
    text-decoration: none;
  }
  :global(.reg-btn:active) { transform: scale(0.97); }
  :global(.reg-btn:disabled) { opacity: 0.6; cursor: not-allowed; }

  :global(.reg-btn--primary) {
    background: #4a08b2;
    color: #fff;
  }
  :global(.reg-btn--primary:hover:not(:disabled)) { background: #33057a; }

  :global(.reg-btn--ghost) {
    background: transparent;
    color: #52525b;
    border: 1.5px solid #e4e4e7;
  }
  :global(.reg-btn--ghost:hover) { background: #f4f4f5; }

  /* ── Payment card ─────────────────────────────────────────────────────── */
  .pay-card {
