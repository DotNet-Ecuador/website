  }
  .reg-event-info__meta {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .reg-event-info__meta li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: #fff;
  }
  .reg-event-info__meta svg { flex-shrink: 0; opacity: 0.9; }

  .reg-left__tagline {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.4);
    letter-spacing: 0.02em;
  }

  /* ── Right panel ──────────────────────────────────────────────────────── */
  .reg-right {
    background: #f8f7ff;
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    overflow-y: auto;
    position: relative;
  }

  /* Mobile header (hidden on desktop) */
  .reg-mobile-header {
    display: none;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.5rem;
    background: #fff;
    border-bottom: 1px solid #ede9ff;
  }
  .reg-mobile-header__logo img { height: 28px; }
  .reg-mobile-header__event {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #33057a;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Progress bar */
  .reg-progress {
    height: 3px;
    background: #ede9ff;
    flex-shrink: 0;
  }
  .reg-progress__bar {
    height: 100%;
    background: #22C55E;
    transition: width 0.4s cubic-bezier(.4,0,.2,1);
  }

  /* Step label */
  .reg-step-label {
    padding: 0.625rem 2.5rem 0;
    font-size: 0.75rem;
    font-weight: 600;
    color: #8b5dff;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* ── Steps ────────────────────────────────────────────────────────────── */
  .reg-steps {
    flex: 1;
    position: relative;
    overflow: hidden;
  }

  .reg-step {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    opacity: 0;
    pointer-events: none;
