---
import logo from '../../assets/dotnet_logo.png';
import '../../assets/styles/base.css';
import { EVENT_SLUGS } from '../../data/events';

const STORAGE_BASE_URL = (import.meta.env.PUBLIC_STORAGE_BASE_URL ?? '').replace(/\/$/, '');
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Registros — DotNet Ecuador</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
</head>
<body>

<div class="shell">

  <!-- ── Sidebar ── -->
  <aside class="sidebar">
    <div class="sidebar-logo">
      <img src={logo.src} alt="DotNet Ecuador" height="26" />
    </div>
    <nav class="sidebar-nav">
      <span class="nav-item nav-item--active">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        Registrados
      </span>
      <button type="button" class="nav-item" id="btn-show-create-event">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Crear evento
      </button>
    </nav>
    <button type="button" class="logout-btn" id="btn-logout">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      Cerrar sesión
    </button>
  </aside>

  <!-- ── Main ── -->
  <main class="main">

    <!-- Page header -->
    <div class="page-header">
      <div>
        <h1 class="page-title">Registros</h1>
        <p class="page-sub">Asistentes registrados en los eventos</p>
      </div>
      <div class="header-actions">
        <button type="button" class="btn btn-ghost" id="btn-exportar">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Exportar CSV
        </button>
        <button type="button" class="btn btn-ghost" id="btn-refresh">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
          Actualizar
        </button>
      </div>
    </div>

    <!-- Stats -->
    <div class="stats-row" id="stats-row">
      <div class="stat-card">
        <span class="stat-val" id="stat-total">—</span>
        <span class="stat-key">Total</span>
      </div>
      <div class="stat-card stat-card--amber">
        <span class="stat-val" id="stat-pendiente">—</span>
        <span class="stat-key">Pendientes</span>
      </div>
      <div class="stat-card stat-card--green">
        <span class="stat-val" id="stat-pagado">—</span>
        <span class="stat-key">Aprobados</span>
      </div>
      <div class="stat-card stat-card--red">
        <span class="stat-val" id="stat-rechazado">—</span>
        <span class="stat-key">Rechazados</span>
      </div>
    </div>

    <!-- Toolbar -->
    <div class="toolbar">
      <div class="search-wrap">
        <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="search-input" class="search-input" placeholder="Buscar por nombre, email o código…" autocomplete="off" />
      </div>
      <select id="filter-evento" class="filter-select" aria-label="Filtrar por evento">
        <option value="">Todos los eventos</option>
      </select>
      <select id="filter-estado" class="filter-select" aria-label="Filtrar por estado">
        <option value="">Todos los estados</option>
        <option value="pendiente">Pendiente</option>
        <option value="pagado">Pagado</option>
        <option value="rechazado">Rechazado</option>
        <option value="cancelado">Cancelado</option>
      </select>
    </div>

    <!-- Table container -->
    <div class="table-card">

      <!-- Loading -->
      <div id="state-loading" class="state-box">
        <svg class="spin" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
        <span>Cargando registros…</span>
      </div>

      <!-- Empty -->
      <div id="state-empty" class="state-box hidden">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:#c4b5fd"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
        <p style="margin:0;font-weight:600;color:#3f3f46">Sin registros</p>
        <p style="margin:0;font-size:.8125rem;color:#a1a1aa">No hay resultados para los filtros aplicados.</p>
      </div>

      <!-- Error -->
      <div id="state-error" class="state-box state-box--error hidden" role="alert">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span id="error-text"></span>
      </div>

      <!-- Table -->
      <table class="data-table hidden" id="data-table">
        <thead>
          <tr>
            <th class="col-asistente">Asistente</th>
            <th class="col-empresa">Empresa / Cargo</th>
            <th class="col-estado">Estado</th>
            <th class="col-fecha">Registrado</th>
            <th class="col-comp">Comprobante</th>
            <th class="col-actions">Acciones</th>
          </tr>
        </thead>
        <tbody id="tbody"></tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div class="pagination-bar hidden" id="pagination-bar">
      <span class="pagination-info" id="pagination-info"></span>
      <div class="pagination-controls" id="pagination-controls"></div>
    </div>

  </main>
</div>

<!-- ── Modal: rechazar ── -->
<div class="overlay hidden" id="reject-overlay" role="dialog" aria-modal="true" aria-labelledby="reject-title">
  <div class="modal">
    <h2 class="modal-title" id="reject-title">Rechazar pago</h2>
    <p class="modal-sub">Indica el motivo para que el asistente pueda corregirlo.</p>
    <textarea id="reject-motivo" rows="3" placeholder="Ej: Comprobante ilegible, monto incorrecto…" class="modal-textarea" maxlength="200"></textarea>
    <div class="modal-footer">
      <button type="button" class="btn btn-ghost" id="reject-cancel">Cancelar</button>
      <button type="button" class="btn btn-danger" id="reject-confirm">Rechazar</button>
    </div>
  </div>
</div>

<!-- ── Modal: comprobante ── -->
<div class="overlay hidden" id="img-overlay" role="dialog" aria-modal="true" aria-labelledby="img-title">
  <div class="modal modal--img">
    <div class="modal-header">
      <h2 class="modal-title" id="img-title">Comprobante de pago</h2>
      <button type="button" class="modal-close" id="img-close" aria-label="Cerrar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <img id="img-preview" src="" alt="Comprobante de pago" class="modal-img" />
    <a id="img-download" href="" target="_blank" rel="noopener noreferrer" class="btn btn-ghost" style="margin-top:.75rem;width:100%;justify-content:center">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      Abrir original
    </a>
  </div>
</div>

<!-- ── Modal: crear evento ── -->
<div class="overlay hidden" id="create-event-overlay" role="dialog" aria-modal="true" aria-labelledby="create-event-title">
  <div class="modal modal--form">
    <div class="modal-header">
      <h2 class="modal-title" id="create-event-title">Crear evento</h2>
      <button type="button" class="modal-close" id="create-event-close" aria-label="Cerrar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <form id="create-event-form" novalidate>
      <div class="form-grid">
        <div class="field"><label class="field-label">Slug *</label><input type="text" name="slug" required placeholder="meetup-titulo-mes-año" class="field-input" /></div>
        <div class="field"><label class="field-label">Nombre *</label><input type="text" name="nombre" required maxlength="120" class="field-input" /></div>
        <div class="field field--full"><label class="field-label">Descripción *</label><textarea name="descripcion" rows="3" required class="modal-textarea modal-textarea--sm"></textarea></div>
        <div class="field"><label class="field-label">Fecha y hora *</label><input type="datetime-local" name="fechaEvento" required class="field-input" /></div>
        <div class="field"><label class="field-label">Lugar *</label><input type="text" name="lugar" required class="field-input" /></div>
        <div class="field"><label class="field-label">Precio ($) *</label><input type="number" name="precio" min="0" step="0.01" required class="field-input" /></div>
        <div class="field"><label class="field-label">Capacidad máxima *</label><input type="number" name="capacidadMaxima" min="1" required class="field-input" /></div>
      </div>
      <p class="form-section-title">Datos bancarios</p>
      <div class="form-grid">
        <div class="field"><label class="field-label">Banco *</label><input type="text" name="banco" required class="field-input" /></div>
        <div class="field"><label class="field-label">Tipo de cuenta *</label><input type="text" name="tipoCuenta" required placeholder="Ahorro / Corriente" class="field-input" /></div>
        <div class="field"><label class="field-label">Número de cuenta *</label><input type="text" name="numeroCuenta" required class="field-input" /></div>
        <div class="field"><label class="field-label">Titular *</label><input type="text" name="titular" required class="field-input" /></div>
        <div class="field"><label class="field-label">RUC / Cédula <span class="field-label--opt">(opc.)</span></label><input type="text" name="ruc" class="field-input" /></div>
      </div>
      <div class="modal-footer" style="margin-top:1.5rem">
        <div id="create-event-error" class="inline-error hidden" style="flex:1"></div>
        <button type="button" class="btn btn-ghost" id="create-event-cancel-btn">Cancelar</button>
        <button type="submit" class="btn btn-primary" id="create-event-submit">
          <span id="create-event-submit-label">Crear evento</span>
          <span id="create-event-submit-spinner" class="hidden"><svg class="spin" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg></span>
        </button>
      </div>
    </form>
  </div>
</div>

<script define:vars={{ EVENT_SLUGS, STORAGE_BASE_URL }}>
  window.__eventSlugs    = EVENT_SLUGS;
  window.__storageBase   = STORAGE_BASE_URL;
</script>

<script>
  import { apiService } from '../../services/api';
  import type { AdminRegistro } from '../../types/api';

  const jwt = sessionStorage.getItem('adminJwt');
  if (!jwt) window.location.replace('/admin');

  const PAGE_SIZE = 20;

  let currentEventoId: string | null = null;
  let pendingRejectId: string | null = null;
  let allRegistros: AdminRegistro[]      = [];
  let filteredRegistros: AdminRegistro[] = [];
  let currentPage = 1;

  const filterEvento  = document.getElementById('filter-evento') as HTMLSelectElement;
  const filterEstado  = document.getElementById('filter-estado') as HTMLSelectElement;
  const searchInput   = document.getElementById('search-input') as HTMLInputElement;
  const stateLoading  = document.getElementById('state-loading')!;
  const stateEmpty    = document.getElementById('state-empty')!;
  const stateError    = document.getElementById('state-error')!;
  const errorText     = document.getElementById('error-text')!;
  const table         = document.getElementById('data-table')!;
  const tbody         = document.getElementById('tbody')!;
  const paginationBar = document.getElementById('pagination-bar')!;
  const paginationInfo= document.getElementById('pagination-info')!;
  const paginationCtrl= document.getElementById('pagination-controls')!;
  const rejectOverlay = document.getElementById('reject-overlay')!;
  const rejectMotivo  = document.getElementById('reject-motivo') as HTMLTextAreaElement;
  const imgOverlay    = document.getElementById('img-overlay')!;
  const imgPreview    = document.getElementById('img-preview') as HTMLImageElement;
  const imgDownload   = document.getElementById('img-download') as HTMLAnchorElement;
  const createEventOverlay = document.getElementById('create-event-overlay')!;

  const storageBase   = ((window as any).__storageBase as string ?? '').replace(/\/$/, '');
  const AVATAR_COLORS = ['#5b21b6','#0369a1','#0f766e','#b45309','#be185d','#7c3aed','#1d4ed8'];

  function comprobanteFullUrl(raw: string): string {
    if (!raw) return '';
    if (raw.startsWith('http://') || raw.startsWith('https://')) return raw;
    const base = storageBase || (import.meta.env.PUBLIC_API_BASE_URL ?? '').replace(/\/$/, '');
    return `${base}/${raw}`;
  }

  function avatarColor(name: string): string {
    const h = [...name].reduce((a, c) => a + c.charCodeAt(0), 0);
    return AVATAR_COLORS[h % AVATAR_COLORS.length];
  }

  function initials(name: string): string {
    const parts = name.trim().split(/\s+/).filter(Boolean);
    if (!parts.length) return '?';
    return parts.length === 1
      ? parts[0][0].toUpperCase()
      : (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
  }

  function fmtDate(iso: string | null | undefined): string {
    if (!iso) return '—';
    return new Date(iso).toLocaleDateString('es-EC', { day: '2-digit', month: 'short', year: 'numeric' });
  }

  function badgeHtml(estado: string): string {
    const map: Record<string, [string, string]> = {
      pendiente: ['badge badge--amber', 'Pendiente'],
      pagado:    ['badge badge--green', 'Aprobado'],
      rechazado: ['badge badge--red',   'Rechazado'],
      cancelado: ['badge badge--gray',  'Cancelado'],
    };
    const [cls, label] = map[estado] ?? ['badge badge--gray', estado];
    return `<span class="${cls}">${label}</span>`;
  }

  function setState(s: 'loading' | 'empty' | 'error' | 'data') {
    stateLoading.classList.toggle('hidden', s !== 'loading');
    stateEmpty.classList.toggle('hidden',   s !== 'empty');
    stateError.classList.toggle('hidden',   s !== 'error');
    table.classList.toggle('hidden',        s !== 'data');
    paginationBar.classList.toggle('hidden', s !== 'data');
  }

  function showError(msg: string) {
    errorText.textContent = msg;
    setState('error');
  }

  function updateStats(items: AdminRegistro[]) {
    let pendiente = 0, pagado = 0, rechazado = 0;
    items.forEach(r => {
      if (r.estado === 'pendiente') pendiente++;
      else if (r.estado === 'pagado') pagado++;
      else if (r.estado === 'rechazado') rechazado++;
    });
    document.getElementById('stat-total')!.textContent     = String(items.length);
    document.getElementById('stat-pendiente')!.textContent = String(pendiente);
    document.getElementById('stat-pagado')!.textContent    = String(pagado);
    document.getElementById('stat-rechazado')!.textContent = String(rechazado);
  }

  function renderPage() {
    const start = (currentPage - 1) * PAGE_SIZE;
    const page  = filteredRegistros.slice(start, start + PAGE_SIZE);

    tbody.innerHTML = '';
    page.forEach(r => {
      const name   = r.nombreAsistente || '';
      const email  = r.emailAsistente  || '';
      const color  = avatarColor(name || email || r.idCorto);
      const ini    = initials(name || email.split('@')[0] || '?');

      const tr = document.createElement('tr');
      tr.dataset.id = r.id;
      tr.innerHTML = `
        <td class="col-asistente">
          <div class="asistente-cell">
            <span class="avatar" style="background:${color}">${ini}</span>
            <div class="asistente-info">
              <span class="asistente-name">${name || '—'}</span>
              <span class="asistente-email">${email || '—'}</span>
              <code class="id-code">${r.idCorto}</code>
            </div>
          </div>
        </td>
        <td class="col-empresa">
          <div class="empresa-cell">
            <span>${r.empresaAsistente || '—'}</span>
            ${r.cargoAsistente ? `<span class="cargo-sub">${r.cargoAsistente}</span>` : ''}
          </div>
        </td>
        <td class="col-estado">${badgeHtml(r.estado)}</td>
        <td class="col-fecha">${fmtDate(r.registradoEn)}</td>
        <td class="col-comp">
          ${r.comprobanteUrl
            ? `<button class="link-btn" data-comp="${comprobanteFullUrl(r.comprobanteUrl)}">Ver</button>`
            : '<span class="muted">—</span>'}
        </td>
        <td class="col-actions">
          <div class="action-group">
            ${r.estado === 'pendiente' ? `
              <button class="icon-btn icon-btn--green" data-aprobar="${r.id}" title="Aprobar pago">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              </button>
              <button class="icon-btn icon-btn--amber" data-rechazar="${r.id}" title="Rechazar pago">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            ` : ''}
            <button class="icon-btn icon-btn--red" data-eliminar="${r.id}" title="Eliminar registro">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
            </button>
          </div>
        </td>
      `;
      tbody.appendChild(tr);
    });

    tbody.querySelectorAll<HTMLButtonElement>('[data-aprobar]').forEach(b =>
      b.addEventListener('click', () => handleAprobar(b.dataset.aprobar!)));
    tbody.querySelectorAll<HTMLButtonElement>('[data-rechazar]').forEach(b =>
      b.addEventListener('click', () => openRejectModal(b.dataset.rechazar!)));
    tbody.querySelectorAll<HTMLButtonElement>('[data-comp]').forEach(b =>
      b.addEventListener('click', () => openImgModal(b.dataset.comp!)));
    tbody.querySelectorAll<HTMLButtonElement>('[data-eliminar]').forEach(b =>
      b.addEventListener('click', () => handleEliminar(b.dataset.eliminar!)));

    renderPagination();
  }

  function renderPagination() {
    const total = filteredRegistros.length;
    const pages = Math.ceil(total / PAGE_SIZE);
    const start = (currentPage - 1) * PAGE_SIZE + 1;
    const end   = Math.min(currentPage * PAGE_SIZE, total);

    paginationInfo.textContent = total === 0 ? '' : `Mostrando ${start}–${end} de ${total} registros`;

    paginationCtrl.innerHTML = '';
    if (pages <= 1) return;

    const mkBtn = (label: string, page: number, disabled = false, active = false) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = label;
      btn.className = `page-btn${active ? ' page-btn--active' : ''}`;
      btn.disabled = disabled;
      btn.addEventListener('click', () => { currentPage = page; renderPage(); });
      return btn;
    };

    paginationCtrl.appendChild(mkBtn('←', currentPage - 1, currentPage === 1));

    const range = buildPageRange(currentPage, pages);
    range.forEach(p => {
      if (p === '…') {
        const el = document.createElement('span');
        el.className = 'page-ellipsis';
        el.textContent = '…';
        paginationCtrl.appendChild(el);
      } else {
        paginationCtrl.appendChild(mkBtn(String(p), p as number, false, p === currentPage));
      }
    });

    paginationCtrl.appendChild(mkBtn('→', currentPage + 1, currentPage === pages));
  }

  function buildPageRange(current: number, total: number): (number | '…')[] {
    if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
    if (current <= 4) return [1, 2, 3, 4, 5, '…', total];
    if (current >= total - 3) return [1, '…', total-4, total-3, total-2, total-1, total];
    return [1, '…', current-1, current, current+1, '…', total];
  }

  function applyFilters() {
    const q      = searchInput.value.trim().toLowerCase();
    const estado = filterEstado.value;

    filteredRegistros = allRegistros.filter(r => {
      if (estado && r.estado !== estado) return false;
      if (q) {
        const hay = [r.nombreAsistente, r.emailAsistente, r.idCorto, r.empresaAsistente, r.cargoAsistente]
          .join(' ').toLowerCase();
        if (!hay.includes(q)) return false;
      }
      return true;
    });

    currentPage = 1;
    if (filteredRegistros.length === 0) { setState('empty'); return; }
    setState('data');
    renderPage();
  }

  async function fetchAllPages(eventoId?: string): Promise<AdminRegistro[] | null> {
    const collected: AdminRegistro[] = [];
    let page = 1;

    while (true) {
      const res = await apiService.getAdminRegistros(jwt!, { eventoId, pageSize: 100, page });

      if (!res.success) {
        if (res.message?.includes('401') || res.message?.includes('403') || res.message?.toLowerCase().includes('unauthorized')) {
          sessionStorage.removeItem('adminJwt');
          window.location.replace('/admin');
          return null;
        }
        showError(res.message ?? 'Error al cargar registros.');
        return null;
      }

      const batch = res.data?.data ?? [];
      collected.push(...batch);

      if (!res.data?.hasNextPage || batch.length === 0) break;
      page++;
    }

    return collected;
  }

  async function loadRegistros() {
    setState('loading');

    const selectedSlug = filterEvento.value;

    if (selectedSlug && !currentEventoId) {
      const res = await apiService.getEvento(selectedSlug);
      if (res.success && res.data) {
        currentEventoId = res.data.id ?? res.data._id ?? null;
      }
    }
    if (!selectedSlug) currentEventoId = null;

    const items = await fetchAllPages(currentEventoId ?? undefined);
    if (items === null) return;
    allRegistros = [...items].sort((a, b) =>
      new Date(b.registradoEn).getTime() - new Date(a.registradoEn).getTime()
    );

    updateStats(allRegistros);
    applyFilters();
  }

  async function handleAprobar(id: string) {
    if (!confirm('¿Aprobar este pago?')) return;
    const res = await apiService.aprobarRegistro(id, jwt!);
    if (!res.success) { alert(res.message ?? 'Error al aprobar.'); return; }
    loadRegistros();
  }

  function openRejectModal(id: string) {
    pendingRejectId = id;
    rejectMotivo.value = '';
    rejectOverlay.classList.remove('hidden');
    rejectMotivo.focus();
  }

  async function handleEliminar(id: string) {
    if (!confirm('¿Eliminar este registro? Esta acción no se puede deshacer.')) return;
    const res = await apiService.eliminarRegistro(id, jwt!);
    if (!res.success) { alert(res.message ?? 'Error al eliminar.'); return; }
    loadRegistros();
  }

  function openImgModal(url: string) {
    imgPreview.src = url;
    imgDownload.href = url;
    imgOverlay.classList.remove('hidden');
  }

  document.getElementById('reject-cancel')!.addEventListener('click', () => {
    rejectOverlay.classList.add('hidden');
    pendingRejectId = null;
  });

  document.getElementById('reject-confirm')!.addEventListener('click', async () => {
    if (!pendingRejectId) return;
    const motivo = rejectMotivo.value.trim();
    if (!motivo) { rejectMotivo.focus(); return; }
    const res = await apiService.rechazarRegistro(pendingRejectId, motivo, jwt!);
    rejectOverlay.classList.add('hidden');
    pendingRejectId = null;
    if (!res.success) { alert(res.message ?? 'Error al rechazar.'); return; }
    loadRegistros();
  });

  rejectOverlay.addEventListener('click', e => {
    if (e.target === rejectOverlay) { rejectOverlay.classList.add('hidden'); pendingRejectId = null; }
  });

  document.getElementById('img-close')!.addEventListener('click', () => imgOverlay.classList.add('hidden'));
  imgOverlay.addEventListener('click', e => { if (e.target === imgOverlay) imgOverlay.classList.add('hidden'); });

  document.getElementById('btn-exportar')!.addEventListener('click', async () => {
    if (!currentEventoId) { alert('Selecciona un evento para exportar.'); return; }
    try {
      const blob = await apiService.exportarCSV(currentEventoId, jwt!);
      const url  = URL.createObjectURL(blob);
      const a    = document.createElement('a');
      a.href = url;
      a.download = `registros-${filterEvento.value}-${new Date().toISOString().slice(0,10)}.csv`;
      a.click();
      URL.revokeObjectURL(url);
    } catch { alert('Error al exportar CSV.'); }
  });

  document.getElementById('btn-show-create-event')!.addEventListener('click', () =>
    createEventOverlay.classList.remove('hidden'));

  function closeCreateModal() {
    createEventOverlay.classList.add('hidden');
    (document.getElementById('create-event-form') as HTMLFormElement).reset();
    document.getElementById('create-event-error')!.classList.add('hidden');
  }

  document.getElementById('create-event-close')!.addEventListener('click', closeCreateModal);
  document.getElementById('create-event-cancel-btn')!.addEventListener('click', closeCreateModal);
  createEventOverlay.addEventListener('click', e => { if (e.target === createEventOverlay) closeCreateModal(); });

  document.getElementById('create-event-form')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form    = e.target as HTMLFormElement;
    const data    = Object.fromEntries(new FormData(form));
    const errEl   = document.getElementById('create-event-error')!;
    const btn     = document.getElementById('create-event-submit') as HTMLButtonElement;
    const label   = document.getElementById('create-event-submit-label')!;
    const spinner = document.getElementById('create-event-submit-spinner')!;

    btn.disabled = true; label.classList.add('hidden'); spinner.classList.remove('hidden');

    const result = await apiService.crearEvento({
      slug:            String(data.slug).trim(),
      nombre:          String(data.nombre).trim(),
      descripcion:     String(data.descripcion).trim(),
      fechaEvento:     new Date(String(data.fechaEvento)).toISOString(),
      lugar:           String(data.lugar).trim(),
      precio:          Number(data.precio),
      capacidadMaxima: Number(data.capacidadMaxima),
      activo: true,
      datosTransferencia: {
        banco:         String(data.banco).trim(),
        tipoCuenta:    String(data.tipoCuenta).trim(),
        numeroCuenta:  String(data.numeroCuenta).trim(),
        titular:       String(data.titular).trim(),
        ruc: data.ruc ? String(data.ruc).trim() : undefined,
      },
    }, jwt!);

    btn.disabled = false; label.classList.remove('hidden'); spinner.classList.add('hidden');

    if (!result.success) {
      errEl.textContent = result.message ?? 'Error al crear el evento.';
      errEl.classList.remove('hidden');
      return;
    }
    closeCreateModal();
    alert(`Evento creado. Recuerda agregar el slug "${data.slug}" a src/data/events.ts.`);
  });

  (async () => {
    const slugs: string[] = (window as any).__eventSlugs ?? [];
    const results = await Promise.all(slugs.map(s => apiService.getEvento(s)));
    results.forEach((r, i) => {
      if (!r.success || !r.data) return;
      const opt = document.createElement('option');
      opt.value = slugs[i];
      opt.textContent = r.data.nombre ?? slugs[i];
      filterEvento.appendChild(opt);
    });
  })();

  filterEvento.addEventListener('change', () => { currentEventoId = null; loadRegistros(); });
  filterEstado.addEventListener('change', applyFilters);
  document.getElementById('btn-refresh')!.addEventListener('click', loadRegistros);
  document.getElementById('btn-logout')!.addEventListener('click', () => {
    sessionStorage.removeItem('adminJwt');
    window.location.replace('/admin');
  });

  let searchTimeout: ReturnType<typeof setTimeout>;
  searchInput.addEventListener('input', () => {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(applyFilters, 220);
  });

  loadRegistros();
</script>

</body>
</html>

