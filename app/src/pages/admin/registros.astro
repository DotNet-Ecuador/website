---
import logo from '../../assets/dotnet_logo.png';
import '../../assets/styles/base.css';
import { EVENT_SLUGS } from '../../data/events';
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Registros — DotNet Ecuador</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&display=swap"
    rel="stylesheet"
    media="print"
    onload="this.media='all'"
  />
</head>
<body class="font-dmsans bg-neutral-100 min-h-screen">

  <!-- Sidebar + Main layout -->
  <div class="adm-shell">

    <!-- ── Sidebar ── -->
    <aside class="adm-sidebar">
      <div class="adm-sidebar__logo">
        <img src={logo.src} alt="DotNet Ecuador" height="32" />
      </div>
      <nav class="adm-nav">
        <span class="adm-nav__item adm-nav__item--active">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          Registrados
        </span>
        <button type="button" class="adm-nav__item" id="btn-show-create-event">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Crear evento
        </button>
      </nav>
      <button type="button" class="adm-logout" id="btn-logout">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Cerrar sesión
      </button>
    </aside>

    <!-- ── Main ── -->
    <main class="adm-main">

      <!-- Filters bar -->
      <div class="adm-filters">
        <div class="adm-filters__left">
          <h1 class="adm-title">Registros</h1>
          <div class="adm-filters__selects">
            <select id="filter-evento" class="adm-select" aria-label="Filtrar por evento">
              <option value="">Todos los eventos</option>
              <!-- populated by JS from API -->
            </select>
            <select id="filter-estado" class="adm-select" aria-label="Filtrar por estado">
              <option value="">Todos los estados</option>
              <option value="pendiente">Pendiente</option>
              <option value="pagado">Pagado</option>
              <option value="rechazado">Rechazado</option>
              <option value="cancelado">Cancelado</option>
            </select>
          </div>
        </div>
        <div class="adm-filters__right">
          <button type="button" class="adm-btn adm-btn--outline" id="btn-exportar" aria-label="Exportar CSV">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Exportar CSV
          </button>
          <button type="button" class="adm-btn adm-btn--primary" id="btn-refresh">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
            Actualizar
          </button>
        </div>
      </div>

      <!-- Stats row -->
      <div class="adm-stats" id="adm-stats">
        <div class="adm-stat">
          <span class="adm-stat__val" id="stat-total">—</span>
          <span class="adm-stat__key">Total</span>
        </div>
        <div class="adm-stat adm-stat--yellow">
          <span class="adm-stat__val" id="stat-pendiente">—</span>
          <span class="adm-stat__key">Pendientes</span>
        </div>
        <div class="adm-stat adm-stat--green">
          <span class="adm-stat__val" id="stat-pagado">—</span>
          <span class="adm-stat__key">Aprobados</span>
        </div>
        <div class="adm-stat adm-stat--red">
          <span class="adm-stat__val" id="stat-rechazado">—</span>
          <span class="adm-stat__key">Rechazados</span>
        </div>
      </div>

      <!-- Table -->
      <div class="adm-table-wrap">
        <div id="adm-loading" class="adm-loading" aria-live="polite">
          <svg class="spin" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
          Cargando registros…
        </div>
        <div id="adm-empty" class="adm-empty hidden" aria-live="polite">
          No hay registros para los filtros seleccionados.
        </div>
        <div id="adm-error-msg" class="adm-error-msg hidden" role="alert"></div>

        <table class="adm-table hidden" id="adm-table">
          <thead>
            <tr>
              <th>Código</th>
              <th>Nombre</th>
              <th>Email</th>
              <th>Empresa</th>
              <th>Cargo</th>
              <th>Estado</th>
              <th>Referencia</th>
              <th>Comprobante</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody id="adm-tbody"></tbody>
        </table>
      </div>
    </main>
  </div>

  <!-- ── Modal: reject reason ── -->
  <div class="adm-modal-overlay hidden" id="reject-overlay" role="dialog" aria-modal="true" aria-labelledby="reject-title">
    <div class="adm-modal">
      <h2 class="adm-modal__title" id="reject-title">Rechazar pago</h2>
      <p class="adm-modal__sub">Indica el motivo para que el asistente pueda corregirlo.</p>
      <textarea
        id="reject-motivo"
        rows="3"
        placeholder="Ej: Comprobante ilegible, monto incorrecto…"
        class="adm-textarea"
        maxlength="200"
      ></textarea>
      <div class="adm-modal__footer">
        <button type="button" class="adm-btn adm-btn--outline" id="reject-cancel">Cancelar</button>
        <button type="button" class="adm-btn adm-btn--danger" id="reject-confirm">Rechazar</button>
      </div>
    </div>
  </div>

  <!-- ── Modal: comprobante image ── -->
  <div class="adm-modal-overlay hidden" id="img-overlay" role="dialog" aria-modal="true" aria-labelledby="img-title">
    <div class="adm-modal adm-modal--img">
      <div class="adm-modal__header">
        <h2 class="adm-modal__title" id="img-title">Comprobante</h2>
        <button type="button" class="adm-modal__close" id="img-close" aria-label="Cerrar">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <img id="img-preview" src="" alt="Comprobante de pago" class="adm-modal__img" />
      <a id="img-download" href="" target="_blank" rel="noopener noreferrer" class="adm-btn adm-btn--outline" style="margin-top:1rem; display:inline-flex; align-items:center; gap:0.375rem;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Abrir original
      </a>
    </div>
  </div>

  <!-- ── Modal: crear evento ── -->
  <div class="adm-modal-overlay hidden" id="create-event-overlay" role="dialog" aria-modal="true" aria-labelledby="create-event-title">
    <div class="adm-modal adm-modal--form">
      <div class="adm-modal__header">
        <h2 class="adm-modal__title" id="create-event-title">Crear evento</h2>
        <button type="button" class="adm-modal__close" id="create-event-close" aria-label="Cerrar">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <form id="create-event-form" class="create-form" novalidate>
        <div class="create-form__grid">
          <div class="adm-field"><label class="adm-label">Slug *</label><input type="text" name="slug" required placeholder="meetup-titulo-mes-año" class="adm-input" /></div>
          <div class="adm-field"><label class="adm-label">Nombre *</label><input type="text" name="nombre" required maxlength="120" class="adm-input" /></div>
          <div class="adm-field adm-field--full"><label class="adm-label">Descripción *</label><textarea name="descripcion" rows="3" required class="adm-textarea adm-textarea--sm"></textarea></div>
          <div class="adm-field"><label class="adm-label">Fecha y hora *</label><input type="datetime-local" name="fechaEvento" required class="adm-input" /></div>
          <div class="adm-field"><label class="adm-label">Lugar *</label><input type="text" name="lugar" required class="adm-input" /></div>
          <div class="adm-field"><label class="adm-label">Precio ($) *</label><input type="number" name="precio" min="0" step="0.01" required class="adm-input" /></div>
          <div class="adm-field"><label class="adm-label">Capacidad máxima *</label><input type="number" name="capacidadMaxima" min="1" required class="adm-input" /></div>
        </div>
        <p class="create-form__section-title">Datos bancarios</p>
        <div class="create-form__grid">
          <div class="adm-field"><label class="adm-label">Banco *</label><input type="text" name="banco" required class="adm-input" /></div>
          <div class="adm-field"><label class="adm-label">Tipo de cuenta *</label><input type="text" name="tipoCuenta" required placeholder="Ahorro / Corriente" class="adm-input" /></div>
          <div class="adm-field"><label class="adm-label">Número de cuenta *</label><input type="text" name="numeroCuenta" required class="adm-input" /></div>
          <div class="adm-field"><label class="adm-label">Titular *</label><input type="text" name="titular" required class="adm-input" /></div>
          <div class="adm-field"><label class="adm-label">RUC / Cédula <span style="font-weight:400;color:#71717a">(opc.)</span></label><input type="text" name="ruc" class="adm-input" /></div>
        </div>
        <div class="adm-modal__footer" style="margin-top:1.5rem;">
          <div id="create-event-error" class="adm-error-msg hidden" style="flex:1"></div>
          <button type="button" class="adm-btn adm-btn--outline" id="create-event-cancel-btn">Cancelar</button>
          <button type="submit" class="adm-btn adm-btn--primary" id="create-event-submit">
            <span id="create-event-submit-label">Crear evento</span>
            <span id="create-event-submit-spinner" class="hidden"><svg class="spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg></span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <script define:vars={{ EVENT_SLUGS }}>
    window.__eventSlugs = EVENT_SLUGS;
  </script>

  <script>
    import { apiService } from '../../services/api';
    import type { AdminRegistro } from '../../types/api';

    // ── Auth guard ──────────────────────────────────────────────────────
    const jwt = sessionStorage.getItem('adminJwt');
    if (!jwt) window.location.replace('/admin');

    // ── State ────────────────────────────────────────────────────────────
    let currentEventoId: string | null = null;
    let pendingRejectId: string | null = null;
    let allRegistros: AdminRegistro[] = [];

    // ── DOM refs ─────────────────────────────────────────────────────────
    const filterEvento  = document.getElementById('filter-evento') as HTMLSelectElement;
    const filterEstado  = document.getElementById('filter-estado') as HTMLSelectElement;
    const loading       = document.getElementById('adm-loading')!;
    const emptyMsg      = document.getElementById('adm-empty')!;
    const errorMsg      = document.getElementById('adm-error-msg')!;
    const table         = document.getElementById('adm-table')!;
    const tbody         = document.getElementById('adm-tbody')!;
    const rejectOverlay = document.getElementById('reject-overlay')!;
    const rejectMotivo  = document.getElementById('reject-motivo') as HTMLTextAreaElement;
    const imgOverlay    = document.getElementById('img-overlay')!;
    const imgPreview    = document.getElementById('img-preview') as HTMLImageElement;
    const imgDownload   = document.getElementById('img-download') as HTMLAnchorElement;
    const createEventOverlay = document.getElementById('create-event-overlay')!;

    // ── Helpers ───────────────────────────────────────────────────────────
    function badgeClass(estado: string) {
      return {
        pendiente: 'badge--yellow',
        pagado:    'badge--green',
        rechazado: 'badge--red',
        cancelado: 'badge--gray',
      }[estado] ?? 'badge--gray';
    }

    function badgeLabel(estado: string) {
      return { pendiente: 'Pendiente', pagado: 'Aprobado', rechazado: 'Rechazado', cancelado: 'Cancelado' }[estado] ?? estado;
    }

    function setLoading(show: boolean) {
      loading.classList.toggle('hidden', !show);
      table.classList.toggle('hidden', show || allRegistros.length === 0);
      emptyMsg.classList.toggle('hidden', show || allRegistros.length > 0);
    }

    function showError(msg: string) {
      errorMsg.textContent = msg;
      errorMsg.classList.remove('hidden');
      loading.classList.add('hidden');
    }

    function updateStats(items: AdminRegistro[]) {
      const counts = { total: items.length, pendiente: 0, pagado: 0, rechazado: 0 };
      items.forEach(r => {
        if (r.estado in counts) (counts as any)[r.estado]++;
      });
      document.getElementById('stat-total')!.textContent    = String(counts.total);
      document.getElementById('stat-pendiente')!.textContent = String(counts.pendiente);
      document.getElementById('stat-pagado')!.textContent    = String(counts.pagado);
      document.getElementById('stat-rechazado')!.textContent = String(counts.rechazado);
    }

    function renderRows(items: AdminRegistro[]) {
      tbody.innerHTML = '';
      items.forEach(r => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><code class="adm-code">${r.idCorto}</code></td>
          <td>${r.nombreAsistente || '—'}</td>
          <td class="adm-td-email">${r.emailAsistente || '—'}</td>
          <td>${r.empresaAsistente || '—'}</td>
          <td>${r.cargoAsistente || '—'}</td>
          <td><span class="adm-badge ${badgeClass(r.estado)}">${badgeLabel(r.estado)}</span></td>
          <td>${r.referenciaPago ?? '—'}</td>
          <td>${r.comprobanteUrl
            ? `<button class="adm-link" data-comprobante="${r.comprobanteUrl}">Ver</button>`
            : '—'
          }</td>
          <td class="adm-td-actions">
            ${r.estado === 'pendiente' ? `
              <button class="adm-btn adm-btn--sm adm-btn--success" data-aprobar="${r.id}" title="Aprobar pago">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                Aprobar
              </button>
              <button class="adm-btn adm-btn--sm adm-btn--danger" data-rechazar="${r.id}" title="Rechazar pago">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                Rechazar
              </button>
            ` : ''}
          </td>
        `;
        tbody.appendChild(tr);
      });

      // Wire up approve/reject/comprobante buttons
      tbody.querySelectorAll<HTMLButtonElement>('[data-aprobar]').forEach(btn => {
        btn.addEventListener('click', () => handleAprobar(btn.dataset.aprobar!));
      });
      tbody.querySelectorAll<HTMLButtonElement>('[data-rechazar]').forEach(btn => {
        btn.addEventListener('click', () => openRejectModal(btn.dataset.rechazar!));
      });
      tbody.querySelectorAll<HTMLButtonElement>('[data-comprobante]').forEach(btn => {
        btn.addEventListener('click', () => openImgModal(btn.dataset.comprobante!));
      });
    }

    // ── Load registros ────────────────────────────────────────────────────
    async function loadRegistros() {
      setLoading(true);
      errorMsg.classList.add('hidden');

      const selectedSlug = filterEvento.value;
      const estado       = filterEstado.value;

      // If a slug is selected, get the eventoId first
      if (selectedSlug && !currentEventoId) {
        const eventoRes = await apiService.getEvento(selectedSlug);
        if (eventoRes.success && eventoRes.data) {
          currentEventoId = eventoRes.data.id ?? eventoRes.data._id ?? null;
        }
      }
      if (!selectedSlug) currentEventoId = null;

      const result = await apiService.getAdminRegistros(jwt!, {
        eventoId: currentEventoId ?? undefined,
        estado: estado || undefined,
        pageSize: 100,
      });

      if (!result.success) {
        if (result.message?.includes('401') || result.message?.includes('403')) {
          sessionStorage.removeItem('adminJwt');
          window.location.replace('/admin');
          return;
        }
        showError(result.message ?? 'Error al cargar registros.');
        return;
      }

      allRegistros = result.data?.data ?? [];
      updateStats(allRegistros);
      renderRows(allRegistros);
      setLoading(false);

      if (allRegistros.length === 0) {
        table.classList.add('hidden');
        emptyMsg.classList.remove('hidden');
      }
    }

    // ── Approve ───────────────────────────────────────────────────────────
    async function handleAprobar(id: string) {
      if (!confirm('¿Aprobar este pago?')) return;
      const result = await apiService.aprobarRegistro(id, jwt!);
      if (!result.success) {
        alert(result.message ?? 'Error al aprobar.');
        return;
      }
      loadRegistros();
    }

    // ── Reject modal ──────────────────────────────────────────────────────
    function openRejectModal(id: string) {
      pendingRejectId = id;
      rejectMotivo.value = '';
      rejectOverlay.classList.remove('hidden');
      rejectMotivo.focus();
    }

    document.getElementById('reject-cancel')!.addEventListener('click', () => {
      rejectOverlay.classList.add('hidden');
      pendingRejectId = null;
    });

    document.getElementById('reject-confirm')!.addEventListener('click', async () => {
      if (!pendingRejectId) return;
      const motivo = rejectMotivo.value.trim();
      if (!motivo) { rejectMotivo.focus(); return; }

      const result = await apiService.rechazarRegistro(pendingRejectId, motivo, jwt!);
      rejectOverlay.classList.add('hidden');
      pendingRejectId = null;

      if (!result.success) {
        alert(result.message ?? 'Error al rechazar.');
        return;
      }
      loadRegistros();
    });

    rejectOverlay.addEventListener('click', (e) => {
      if (e.target === rejectOverlay) {
        rejectOverlay.classList.add('hidden');
        pendingRejectId = null;
      }
    });

    // ── Comprobante modal ─────────────────────────────────────────────────
    function openImgModal(url: string) {
      imgPreview.src = url;
      imgDownload.href = url;
      imgOverlay.classList.remove('hidden');
    }

    document.getElementById('img-close')!.addEventListener('click', () => imgOverlay.classList.add('hidden'));
    imgOverlay.addEventListener('click', (e) => {
      if (e.target === imgOverlay) imgOverlay.classList.add('hidden');
    });

    // ── Export CSV ────────────────────────────────────────────────────────
    document.getElementById('btn-exportar')!.addEventListener('click', async () => {
      if (!currentEventoId) {
        alert('Selecciona un evento para exportar.');
        return;
      }
      try {
        const blob = await apiService.exportarCSV(currentEventoId, jwt!);
        const url  = URL.createObjectURL(blob);
        const a    = document.createElement('a');
        a.href = url;
        a.download = `registros-${filterEvento.value}-${new Date().toISOString().slice(0,10)}.csv`;
        a.click();
        URL.revokeObjectURL(url);
      } catch {
        alert('Error al exportar CSV.');
      }
    });

    // ── Create event modal ────────────────────────────────────────────────
    document.getElementById('btn-show-create-event')!.addEventListener('click', () => {
      createEventOverlay.classList.remove('hidden');
    });

    function closeCreateEventModal() {
      createEventOverlay.classList.add('hidden');
      (document.getElementById('create-event-form') as HTMLFormElement).reset();
      document.getElementById('create-event-error')!.classList.add('hidden');
    }

    document.getElementById('create-event-close')!.addEventListener('click', closeCreateEventModal);
    document.getElementById('create-event-cancel-btn')!.addEventListener('click', closeCreateEventModal);
    createEventOverlay.addEventListener('click', (e) => {
      if (e.target === createEventOverlay) closeCreateEventModal();
    });

    document.getElementById('create-event-form')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const data = Object.fromEntries(new FormData(form));
      const errEl = document.getElementById('create-event-error')!;
      const btn   = document.getElementById('create-event-submit') as HTMLButtonElement;
      const label = document.getElementById('create-event-submit-label')!;
      const spinner = document.getElementById('create-event-submit-spinner')!;

      btn.disabled = true;
      label.classList.add('hidden');
      spinner.classList.remove('hidden');

      const result = await apiService.crearEvento({
        slug: String(data.slug).trim(),
        nombre: String(data.nombre).trim(),
        descripcion: String(data.descripcion).trim(),
        fechaEvento: new Date(String(data.fechaEvento)).toISOString(),
        lugar: String(data.lugar).trim(),
        precio: Number(data.precio),
        capacidadMaxima: Number(data.capacidadMaxima),
        activo: true,
        datosTransferencia: {
          banco: String(data.banco).trim(),
          tipoCuenta: String(data.tipoCuenta).trim(),
          numeroCuenta: String(data.numeroCuenta).trim(),
          titular: String(data.titular).trim(),
          ruc: data.ruc ? String(data.ruc).trim() : undefined,
        },
      }, jwt!);

      btn.disabled = false;
      label.classList.remove('hidden');
      spinner.classList.add('hidden');

      if (!result.success) {
        errEl.textContent = result.message ?? 'Error al crear el evento.';
        errEl.classList.remove('hidden');
        return;
      }

      closeCreateEventModal();
      alert(`Evento creado. Recuerda agregar el slug "${data.slug}" al campo slug del evento en src/data/events.ts para activar el flujo de registro.`);
    });

    // ── Populate event dropdown from API ─────────────────────────────────
    (async () => {
      const slugs: string[] = (window as any).__eventSlugs ?? [];
      const results = await Promise.all(slugs.map(s => apiService.getEvento(s)));
      results.forEach((r, i) => {
        if (!r.success || !r.data) return;
        const opt = document.createElement('option');
        opt.value = slugs[i];
        opt.textContent = r.data.nombre ?? slugs[i];
        filterEvento.appendChild(opt);
      });
    })();

    // ── Filters & init ────────────────────────────────────────────────────
    filterEvento.addEventListener('change', () => { currentEventoId = null; loadRegistros(); });
    filterEstado.addEventListener('change', loadRegistros);
    document.getElementById('btn-refresh')!.addEventListener('click', loadRegistros);
    document.getElementById('btn-logout')!.addEventListener('click', () => {
      sessionStorage.removeItem('adminJwt');
      window.location.replace('/admin');
    });

    loadRegistros();
  </script>

</body>
</html>

