---
import logo from '../assets/dotnet_logo.png';
import { Image } from 'astro:assets';
---

<footer class="relative py-16 overflow-hidden"
        style="margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%); padding-left: calc(50vw - 50%); padding-right: calc(50vw - 50%);"
>
  <!-- Background with gradients and glass effect -->
  <div class="absolute inset-0 bg-gradient-to-br from-primary-950 via-primary-900 to-primary-800"></div>
  <div class="absolute inset-0 bg-gradient-to-tr from-primary-900/95 via-primary-800/90 to-primary-700/85"></div>
  
  <!-- Decorative blobs -->
  <div class="absolute -top-20 -right-20 w-80 h-80 bg-gradient-to-br from-primary-600/20 to-primary-700/30 rounded-full blur-3xl"></div>
  <div class="absolute -bottom-20 -left-20 w-80 h-80 bg-gradient-to-tr from-primary-700/25 to-primary-800/35 rounded-full blur-3xl"></div>
  <div class="absolute top-20 left-1/3 w-60 h-60 bg-gradient-to-br from-primary-600/15 to-primary-800/25 rounded-full blur-2xl"></div>
  
  <div class="relative z-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <!-- Main Footer Content -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12 mb-12">
        
        <!-- Brand Section -->
        <div class="lg:col-span-2">
          <div class="flex items-center mb-6">
            <div class="flex-shrink-0 w-12 h-12 mr-4">
              <Image 
                src={logo} 
                alt="Logo de .NET Ecuador" 
                class="w-full h-full object-contain" 
                loading="lazy"
                width={48}
                height={48}
              />
            </div>
            <h3 class="text-2xl font-bold text-white">DotNet Ecuador</h3>
          </div>
          <p class="text-white/90 text-lg mb-6 max-w-md leading-relaxed">
            La comunidad de desarrolladores .NET más grande de Ecuador. Conectamos, educamos y potenciamos el talento tecnológico del país.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/voluntariado" class="inline-flex items-center justify-center px-6 py-3 bg-primary-600/80 backdrop-blur-sm border border-primary-600/50 rounded-xl text-white font-semibold hover:bg-primary-700/90 hover:scale-105 transition-all duration-300">
              Únete a Nosotros
            </a>
            <a href="/sobre-nosotros" class="inline-flex items-center justify-center px-6 py-3 border-2 border-white/70 text-white rounded-xl font-medium hover:bg-white/10 transition-all duration-300">
              Conocer Más
            </a>
          </div>
        </div>

        <!-- Navigation Links -->
        <div>
          <h4 class="text-xl font-semibold text-white mb-6">Navegación</h4>
          <ul class="space-y-3">
            <li><a href="/" class="text-white/80 hover:text-white hover:translate-x-1 transition-all duration-200 inline-block">Inicio</a></li>
            <li><a href="/sobre-nosotros" class="text-white/80 hover:text-white hover:translate-x-1 transition-all duration-200 inline-block">Sobre Nosotros</a></li>
            <li><a href="/equipo" class="text-white/80 hover:text-white hover:translate-x-1 transition-all duration-200 inline-block">Equipo</a></li>
            <li><a href="/eventos" class="text-white/80 hover:text-white hover:translate-x-1 transition-all duration-200 inline-block">Eventos</a></li>
            <li><a href="/proyectos" class="text-white/80 hover:text-white hover:translate-x-1 transition-all duration-200 inline-block">Proyectos</a></li>
            <li><a href="/contacto" class="text-white/80 hover:text-white hover:translate-x-1 transition-all duration-200 inline-block">Contacto</a></li>
          </ul>
        </div>

        <!-- Contact & Social -->
        <div>
          <h4 class="text-xl font-semibold text-white mb-6">Contacto</h4>
          <div class="space-y-4 mb-8">
            <a href="mailto:equipo@dotnetecuador.com" class="flex items-center text-white/80 hover:text-white transition-colors group">
              <svg class="w-5 h-5 mr-3 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
                <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
              </svg>
              equipo@dotnetecuador.com
            </a>
          </div>

          <!-- Social Media -->
          <h5 class="text-lg font-medium text-white mb-4">Síguenos</h5>
          <div class="grid grid-cols-3 gap-3">
            <a href="https://www.linkedin.com/company/dotnet-ecuador/?originalSubdomain=ec" target="_blank" class="group">
              <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl p-3 transition-all duration-300 hover:bg-white/20 hover:scale-110 hover:shadow-lg">
                <svg class="w-6 h-6 text-white mx-auto" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </div>
            </a>

            <a href="https://www.instagram.com/dotnet_ecuador/" target="_blank" class="group">
              <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl p-3 transition-all duration-300 hover:bg-white/20 hover:scale-110 hover:shadow-lg">
                <svg class="w-6 h-6 text-white mx-auto" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
              </div>
            </a>

            <a href="https://www.youtube.com/@dotnet-ecuador" target="_blank" class="group">
              <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl p-3 transition-all duration-300 hover:bg-white/20 hover:scale-110 hover:shadow-lg">
                <svg class="w-6 h-6 text-white mx-auto" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
              </div>
            </a>

            <a href="https://github.com/DotNet-Ecuador" target="_blank" class="group">
              <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl p-3 transition-all duration-300 hover:bg-white/20 hover:scale-110 hover:shadow-lg">
                <svg class="w-6 h-6 text-white mx-auto" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
              </div>
            </a>

            <a href="https://www.meetup.com/es/dotnet-ecuador" target="_blank" class="group">
              <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl p-3 transition-all duration-300 hover:bg-white/20 hover:scale-110 hover:shadow-lg">
                <svg class="w-6 h-6 text-white mx-auto" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M6.9 0C4.7 0 2.9 1.8 2.9 4s1.8 4 4 4 4-1.8 4-4-1.8-4-4-4zM17.1 24c2.2 0 4-1.8 4-4s-1.8-4-4-4-4 1.8-4 4 1.8 4 4 4zm-10.2 0C4.7 24 2.9 22.2 2.9 20s1.8-4 4-4 4 1.8 4 4-1.8 4-4 4zM17.1 8c2.2 0 4-1.8 4-4s-1.8-4-4-4-4 1.8-4 4 1.8 4 4 4z"/>
                </svg>
              </div>
            </a>

            <a href="https://open.spotify.com/show/0UUXZpDtW89OFGxmcy08RI?si=3f19ba238de2464e" target="_blank" class="group">
              <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl p-3 transition-all duration-300 hover:bg-white/20 hover:scale-110 hover:shadow-lg">
                <svg class="w-6 h-6 text-white mx-auto" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.84-.179-.959-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.361 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
                </svg>
              </div>
            </a>
          </div>
        </div>
      </div>

      <!-- Bottom Section -->
      <div class="border-t border-white/20 pt-8">
        <div class="flex flex-col md:flex-row justify-between items-center text-center md:text-left">
          <p class="text-white/80 mb-4 md:mb-0">
            &copy; 2025 DotNet Ecuador. Todos los derechos reservados.
          </p>
          <div class="flex flex-wrap gap-6 text-sm">
            <a href="/privacidad" class="text-white/70 hover:text-white transition-colors">Política de Privacidad</a>
            <a href="/terminos" class="text-white/70 hover:text-white transition-colors">Términos de Uso</a>
            <a href="/cookies" class="text-white/70 hover:text-white transition-colors">Cookies</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Glowing orbs -->
  <div class="absolute -bottom-10 right-1/4 w-32 h-32 bg-gradient-to-br from-primary-600/25 to-primary-700/35 rounded-full blur-2xl"></div>
  <div class="absolute top-1/2 -left-16 w-24 h-24 bg-gradient-to-br from-primary-600/20 to-primary-800/30 rounded-full blur-xl"></div>
</footer>