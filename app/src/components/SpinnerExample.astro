---
// Ejemplo de uso del componente Spinner
import Button from './Button.astro';
import Spinner from './Spinner.astro';
---

<!-- Ejemplo 1: Spinner standalone -->
<div class="p-6 bg-white rounded-lg shadow-md">
  <h3 class="text-lg font-semibold mb-4">Spinners Standalone</h3>
  <div class="space-y-4">
    <!-- Diferentes tamaños -->
    <div class="flex items-center gap-4">
      <Spinner size="sm" text="Pequeño" />
      <Spinner size="md" text="Mediano" />
      <Spinner size="lg" text="Grande" />
    </div>
    
    <!-- Diferentes variantes -->
    <div class="flex items-center gap-4">
      <Spinner variant="primary" text="Primario" />
      <Spinner variant="neutral" text="Neutral" />
      <div class="bg-primary-900 p-3 rounded">
        <Spinner variant="white" text="Blanco" />
      </div>
    </div>
    
    <!-- Con slot personalizado -->
    <Spinner variant="primary" size="md">
      <span class="text-primary-600">Cargando datos...</span>
    </Spinner>
  </div>
</div>

<!-- Ejemplo 2: Botones con estado loading -->
<div class="p-6 bg-white rounded-lg shadow-md mt-6">
  <h3 class="text-lg font-semibold mb-4">Botones con Loading</h3>
  <div class="space-y-4">
    <!-- Botones normales vs loading -->
    <div class="flex items-center gap-4">
      <Button variant="primary">Enviar</Button>
      <Button variant="primary" loading={true}>Enviando</Button>
    </div>
    
    <div class="flex items-center gap-4">
      <Button variant="secondary">Guardar</Button>
      <Button variant="secondary" loading={true}>Guardando</Button>
    </div>
    
    <div class="flex items-center gap-4">
      <Button variant="outline">Procesar</Button>
      <Button variant="outline" loading={true}>Procesando</Button>
    </div>
  </div>
</div>

<!-- Ejemplo 3: Formulario con integración JavaScript -->
<div class="p-6 bg-white rounded-lg shadow-md mt-6">
  <h3 class="text-lg font-semibold mb-4">Formulario de Ejemplo</h3>
  
  <form id="example-form" class="space-y-4">
    <div>
      <label for="name" class="block text-sm font-medium text-gray-700 mb-1">
        Nombre
      </label>
      <input 
        type="text" 
        id="name" 
        name="name" 
        required
        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500"
      >
    </div>
    
    <div>
      <label for="email" class="block text-sm font-medium text-gray-700 mb-1">
        Email
      </label>
      <input 
        type="email" 
        id="email" 
        name="email" 
        required
        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500"
      >
    </div>
    
    <Button 
      id="submit-btn"
      type="submit"
      variant="primary"
    >
      Enviar Formulario
    </Button>
  </form>
  
  <!-- Toast para mostrar resultados -->
  <div id="toast" class="hidden mt-4 p-4 rounded-md" role="alert">
    <div id="toast-message"></div>
  </div>
</div>

<script>
  // Ejemplo de integración con formulario
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('example-form');
    const submitBtn = document.getElementById('submit-btn');
    const toast = document.getElementById('toast');
    const toastMessage = document.getElementById('toast-message');
    
    if (form && submitBtn) {
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        // Cambiar botón a estado loading
        submitBtn.setAttribute('loading', 'true');
        submitBtn.textContent = 'Enviando...';
        
        try {
          // Simular envío de formulario
          await new Promise(resolve => setTimeout(resolve, 2000));
          
          // Simular respuesta exitosa o error (50/50)
          const success = Math.random() > 0.5;
          
          if (success) {
            showToast('¡Formulario enviado exitosamente!', 'success');
            form.reset();
          } else {
            throw new Error('Error al enviar el formulario');
          }
          
        } catch (error) {
          showToast('Error: ' + error.message, 'error');
        } finally {
          // Restaurar botón al estado normal
          submitBtn.removeAttribute('loading');
          submitBtn.textContent = 'Enviar Formulario';
        }
      });
    }
    
    function showToast(message, type) {
      if (!toast || !toastMessage) return;
      
      toastMessage.textContent = message;
      toast.className = `mt-4 p-4 rounded-md ${
        type === 'success' 
          ? 'bg-green-100 text-green-800 border border-green-300' 
          : 'bg-red-100 text-red-800 border border-red-300'
      }`;
      toast.classList.remove('hidden');
      
      // Ocultar después de 5 segundos
      setTimeout(() => {
        toast.classList.add('hidden');
      }, 5000);
    }
  });
</script>

<style>
  /* Estilos adicionales para el ejemplo */
  .space-y-4 > * + * {
    margin-top: 1rem;
  }
  
  .gap-4 {
    gap: 1rem;
  }
</style>