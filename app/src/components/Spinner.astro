---
export interface Props {
  size?: 'sm' | 'md' | 'lg';
  variant?: 'primary' | 'white' | 'neutral';
  text?: string;
  class?: string;
}

const { 
  size = 'md',
  variant = 'primary',
  text,
  class: className = '',
  ...rest 
} = Astro.props;

const sizes = {
  sm: 'w-4 h-4',
  md: 'w-6 h-6', 
  lg: 'w-8 h-8'
};

const variants = {
  primary: 'text-primary-600',
  white: 'text-white',
  neutral: 'text-neutral-600'
};

const textSizes = {
  sm: 'text-sm',
  md: 'text-base',
  lg: 'text-lg'
};

const spinnerClasses = `inline-block animate-spin rounded-full border-2 border-solid border-current border-r-transparent align-[-0.125em] motion-reduce:animate-[spin_1.5s_linear_infinite] ${sizes[size]} ${variants[variant]}`;
---

<div class={`inline-flex items-center gap-2 ${className}`} role="status" aria-label="Cargando" {...rest}>
  <div class={spinnerClasses}></div>
  {text && (
    <span class={`${variants[variant]} ${textSizes[size]} font-medium`}>
      {text}
    </span>
  )}
  {!text && <slot />}
  <span class="sr-only">Cargando...</span>
</div>

<style>
  @keyframes spin {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  .animate-spin {
    animation: spin 1s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .motion-reduce\:animate-\[spin_1\.5s_linear_infinite\] {
      animation: spin 1.5s linear infinite;
    }
  }
</style>