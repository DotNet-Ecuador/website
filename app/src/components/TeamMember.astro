---
export interface Props {
  imageUrl: string;
  name: string;
  role: string;
  delay?: string;
  imageScale?: number;
}

const { imageUrl, name, role, delay = "0ms", imageScale = 1 } = Astro.props;
---

<div class="team-member-card group" style={`animation-delay: ${delay}`}>
  <div class="relative overflow-hidden">
    <!-- Glowing background effect -->
    <div class="absolute inset-0 rounded-3xl bg-gradient-to-br from-primary-400/20 via-primary-500/10 to-primary-600/20 opacity-0 group-hover:opacity-100 transition-opacity duration-700 blur-lg scale-110"></div>
    
    <!-- Main card -->
    <div class="relative bg-gradient-to-br from-white/60 via-white/40 to-white/30 backdrop-blur-xl border border-white/40 rounded-3xl p-6 text-center transition-all duration-500 group-hover:from-white/70 group-hover:via-white/50 group-hover:to-white/40 group-hover:border-white/60 group-hover:shadow-2xl group-hover:shadow-primary-500/20">
      <!-- Avatar container with animated border -->
      <div class="relative mx-auto mb-6 w-32 h-32 sm:w-36 sm:h-36 lg:w-40 lg:h-40">
        <!-- Animated gradient border -->
        <div class="absolute inset-0 rounded-full bg-gradient-to-br from-primary-400 via-primary-500 to-primary-600 opacity-0 group-hover:opacity-100 transition-opacity duration-500 animate-pulse"></div>
        <div class="absolute inset-0.5 rounded-full bg-white"></div>
        
        <!-- Avatar image -->
        <div class="absolute inset-0 rounded-full overflow-hidden z-10 transition-transform duration-500 group-hover:scale-105">
          <img
            src={imageUrl}
            alt={name}
            class="w-full h-full object-cover"
            style={imageScale !== 1 ? `transform: scale(${imageScale}); transform-origin: center center;` : undefined}
            loading="lazy"
          />
        </div>
        
        <!-- Floating particles effect -->
        <div class="absolute -inset-4 opacity-0 group-hover:opacity-100 transition-opacity duration-700">
          <div class="absolute top-0 right-0 w-2 h-2 bg-primary-400 rounded-full animate-bounce" style="animation-delay: 0s;"></div>
          <div class="absolute bottom-2 left-2 w-1.5 h-1.5 bg-primary-500 rounded-full animate-bounce" style="animation-delay: 0.5s;"></div>
          <div class="absolute top-4 left-0 w-1 h-1 bg-primary-600 rounded-full animate-bounce" style="animation-delay: 1s;"></div>
        </div>
      </div>
      
      <!-- Name with gradient text effect -->
      <h2 class="text-xl sm:text-2xl font-bold mb-2 text-primary-900 group-hover:bg-gradient-to-r group-hover:from-primary-600 group-hover:to-primary-800 group-hover:bg-clip-text group-hover:text-transparent transition-all duration-300">
        {name}
      </h2>
      
      <!-- Role with animated underline -->
      <div class="relative mb-4">
        <p class="text-base sm:text-lg text-neutral-600 font-medium group-hover:text-neutral-700 transition-colors duration-300">
          {role}
        </p>
        <!-- Animated underline -->
        <div class="absolute -bottom-1 left-1/2 transform -translate-x-1/2 w-0 h-0.5 bg-gradient-to-r from-primary-500 to-primary-600 group-hover:w-3/4 transition-all duration-500 ease-out"></div>
      </div>
      
      <!-- Social links placeholder (can be expanded) -->
      <div class="opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
        <div class="flex justify-center gap-3">
          <div class="w-8 h-8 bg-gradient-to-br from-primary-400 to-primary-600 rounded-full flex items-center justify-center hover:scale-110 transition-transform duration-200 cursor-pointer">
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </div>
          <div class="w-8 h-8 bg-gradient-to-br from-primary-400 to-primary-600 rounded-full flex items-center justify-center hover:scale-110 transition-transform duration-200 cursor-pointer">
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>


