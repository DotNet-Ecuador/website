---
export interface Props {
  imageUrl: string;
  name: string;
  role: string;
}

const { imageUrl, name, role } = Astro.props;
---

<div class="card w-full max-w-xs sm:max-w-sm mx-auto p-4 sm:p-6 text-center text-primary-900 animate-move-in transition-transform duration-200 hover:-translate-y-1.5 hover:shadow-card-hover">
  <img 
    src={imageUrl} 
    alt={name} 
    class="w-32 h-32 sm:w-40 sm:h-40 lg:w-48 lg:h-48 rounded-full mx-auto mb-3 sm:mb-4 object-cover shadow-md"
    loading="lazy"
  />
  <h2 class="text-lg sm:text-xl lg:text-2xl font-bold mb-1 sm:mb-2 break-words leading-tight">
    {name}
  </h2>
  <p class="text-sm sm:text-base lg:text-lg text-neutral-600 font-medium">
    {role}
  </p>
</div>


