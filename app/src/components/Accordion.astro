---
export interface Props {
  title: string;
  desc: string;
  id: string;
  groupId?: string;
}

const { title, desc, id, groupId = 'default' } = Astro.props;
---

<div class="accordion-item bg-white/60 backdrop-blur-sm border border-white/20 rounded-2xl overflow-hidden hover:bg-white/70 hover:shadow-xl hover:shadow-primary-500/10 transition-all duration-300 group">
  <button
    class="accordion-trigger w-full p-6 text-left flex justify-between items-center focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-inset group-hover:bg-primary-50/50 transition-colors duration-200"
    data-accordion-id={id}
    data-group-id={groupId}
    aria-expanded="false"
    aria-controls={`accordion-content-${id}`}
  >
    <span class="text-lg font-semibold text-primary-900 pr-4">{title}</span>
    <div class="accordion-icon flex-shrink-0 w-6 h-6 transition-transform duration-300">
      <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
      </svg>
    </div>
  </button>
  
  <div 
    class="accordion-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out"
    id={`accordion-content-${id}`}
    aria-labelledby={`accordion-trigger-${id}`}
  >
    <div class="p-6 pt-0 text-neutral-600 leading-relaxed">
      {desc}
    </div>
  </div>
</div>

<script>
  class AccordionManager {
    private accordions: Map<string, Set<HTMLElement>> = new Map();

    constructor() {
      this.init();
    }

    init() {
      document.addEventListener('click', this.handleClick.bind(this));
    }

    handleClick(event: Event) {
      const trigger = (event.target as HTMLElement)?.closest('.accordion-trigger');
      if (!trigger) return;

      event.preventDefault();
      
      const accordionId = trigger.getAttribute('data-accordion-id');
      const groupId = trigger.getAttribute('data-group-id') || 'default';
      
      if (!accordionId) return;

      this.registerAccordion(groupId, trigger as HTMLElement);
      this.toggleAccordion(trigger as HTMLElement, groupId);
    }

    registerAccordion(groupId: string, trigger: HTMLElement) {
      if (!this.accordions.has(groupId)) {
        this.accordions.set(groupId, new Set());
      }
      this.accordions.get(groupId)!.add(trigger);
    }

    toggleAccordion(trigger: HTMLElement, groupId: string) {
      const content = trigger.nextElementSibling as HTMLElement;
      const icon = trigger.querySelector('.accordion-icon') as HTMLElement;
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';

      // Close all other accordions in the same group
      const groupAccordions = this.accordions.get(groupId);
      if (groupAccordions) {
        groupAccordions.forEach(otherTrigger => {
          if (otherTrigger !== trigger) {
            this.closeAccordion(otherTrigger);
          }
        });
      }

      // Toggle current accordion
      if (isOpen) {
        this.closeAccordion(trigger);
      } else {
        this.openAccordion(trigger);
      }
    }

    openAccordion(trigger: HTMLElement) {
      const content = trigger.nextElementSibling as HTMLElement;
      const icon = trigger.querySelector('.accordion-icon') as HTMLElement;
      
      trigger.setAttribute('aria-expanded', 'true');
      icon.style.transform = 'rotate(180deg)';
      
      // Get the natural height
      content.style.maxHeight = content.scrollHeight + 'px';
      content.classList.add('border-t', 'border-primary-100');
    }

    closeAccordion(trigger: HTMLElement) {
      const content = trigger.nextElementSibling as HTMLElement;
      const icon = trigger.querySelector('.accordion-icon') as HTMLElement;
      
      trigger.setAttribute('aria-expanded', 'false');
      icon.style.transform = 'rotate(0deg)';
      content.style.maxHeight = '0px';
      content.classList.remove('border-t', 'border-primary-100');
    }
  }

  // Initialize accordion manager when DOM is loaded
  if (typeof window !== 'undefined') {
    document.addEventListener('DOMContentLoaded', () => {
      new AccordionManager();
    });
  }
</script>
