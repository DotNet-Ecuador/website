---
import type { Event } from '../data/events'

export interface Props {
  event: Event
}

const { event } = Astro.props

const MONTHS_ES = ['ENE', 'FEB', 'MAR', 'ABR', 'MAY', 'JUN', 'JUL', 'AGO', 'SEP', 'OCT', 'NOV', 'DIC']

let dateDay = ''
let dateMonth = ''
let dateYear = ''

if (event.status === 'confirmed' && event.date) {
  const [y, m, d] = event.date.split('-')
  dateDay = d
  dateMonth = MONTHS_ES[parseInt(m) - 1]
  dateYear = y
}

function buildCalendarUrl(event: Event): string {
  if (!event.date) return '#'
  const dateStr = event.date.replace(/-/g, '')
  const start = event.time ? `${dateStr}T${event.time.replace(':', '')}00` : dateStr
  const end = event.endTime ? `${dateStr}T${event.endTime.replace(':', '')}00` : dateStr
  const params = new URLSearchParams({
    action: 'TEMPLATE',
    text: event.title,
    dates: `${start}/${end}`,
    details: event.description,
    location: event.location ?? '',
  })
  return `https://calendar.google.com/calendar/render?${params}`
}

const calendarUrl = event.status === 'confirmed' ? buildCalendarUrl(event) : ''

const formatLabel: Record<string, string> = {
  presencial: 'Presencial',
  virtual: 'Virtual',
  híbrido: 'Híbrido',
}

const formatStyle: Record<string, string> = {
  presencial: 'badge--presencial',
  virtual: 'badge--virtual',
  híbrido: 'badge--hibrido',
}

const typeLabel: Record<string, string> = {
  meetup: 'Meetup',
  workshop: 'Workshop',
  taller: 'Taller Hands-On',
  charla: 'Charla + Demo',
  conference: 'Conferencia',
  webinar: 'Webinar',
  panel: 'Panel',
}
---

<article class={`event-card-v2 animation-fade-up ${event.status === 'confirmed' ? 'event-card-v2--confirmed' : 'event-card-v2--tentative'} ${event.featured ? 'event-card-v2--featured' : ''}`}>

  {event.featured && event.image && (
    <div class="event-card-featured-image">
      <img src={event.image} alt={event.title} loading="lazy" />
    </div>
  )}

  <div class="event-card-v2__body">

  <!-- Top row: date block + badges -->
  <div class="flex items-start gap-4 mb-3">
    {event.status === 'confirmed' ? (
      <div class="event-date event-date--confirmed flex-shrink-0" aria-label={`${dateDay} de ${dateMonth} ${dateYear}`}>
        <span class="event-date__day">{dateDay}</span>
        <span class="event-date__month">{dateMonth}</span>
        <span class="event-date__year">{dateYear}</span>
      </div>
    ) : (
      <div class="event-date event-date--tentative flex-shrink-0" aria-label={`Fecha tentativa: ${event.tentativeDate}`}>
        <span class="event-date__tentative">{event.tentativeDate ?? '?'}</span>
      </div>
    )}

    <div class="flex flex-wrap gap-1.5 pt-1">
      <span class={`event-badge ${formatStyle[event.format]}`}>
        {formatLabel[event.format]}
      </span>
      <span class="event-badge badge--type">
        {typeLabel[event.type]}
      </span>
      {event.networking && (
        <span class="event-badge badge--networking">Networking</span>
      )}
    </div>
  </div>

  <!-- Title -->
  <h2 class="event-title">{event.title}</h2>

  <!-- Speakers -->
  {event.speakers && event.speakers.length > 0 && (
    <div class="event-speakers">
      {event.speakers.map(s => (
        <div class="event-speaker">
          {s.avatar && (
            <div class="event-speaker__avatar-wrapper">
              <img src={s.avatar} alt={s.name} class="event-speaker__avatar" style={s.avatarScale ? `transform: scale(${s.avatarScale})` : ''} />
            </div>
          )}
          <span class="event-speaker__info">{s.name} · {s.role}</span>
        </div>
      ))}
    </div>
  )}

  <!-- Description -->
  <div class="event-description-wrapper">
    <p class="event-description" data-description>{event.description}</p>
    {event.description.length > 120 && (
      <button class="event-toggle" data-toggle aria-expanded="false" type="button">
        Ver más
      </button>
    )}
  </div>

  <!-- Meta row -->
  <div class="event-meta">
    {event.location && (
      <span class="event-meta__item">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/>
        </svg>
        {event.location}
      </span>
    )}
    {event.time && (
      <span class="event-meta__item">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
        </svg>
        {event.time}{event.endTime ? ` – ${event.endTime}` : ''}
      </span>
    )}
    {event.limitedCapacity && (
      <span class="event-meta__item event-meta__limited">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        Aforo limitado
      </span>
    )}
    {event.price && (
      <span class="event-meta__item event-meta__price">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z"/>
        </svg>
        {event.price}
      </span>
    )}
  </div>

  <!-- Tags -->
  {event.tags && event.tags.length > 0 && (
    <div class="event-tags">
      {event.tags.map(tag => (
        <span class="event-tag">#{tag}</span>
      ))}
    </div>
  )}

  <!-- Footer CTAs -->
  <div class="event-footer">
    {event.status === 'confirmed' ? (
      <div class="flex items-center justify-between gap-3 flex-wrap w-full">
        <a
          href={calendarUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-calendar inline-flex items-center gap-2 min-h-[44px]"
          aria-label={`Agregar "${event.title}" a Google Calendar`}
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
          Agregar al calendario
        </a>
        <div class="flex items-center gap-2">
          {event.registrationUrl && (
            <a
              href={event.registrationUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary text-sm px-4 py-2.5 inline-flex items-center gap-2 min-h-[44px]"
            >
              Registrarse
            </a>
          )}
          {event.registrationComingSoon && (
            <button class="btn-primary text-sm px-4 py-2.5 inline-flex items-center gap-2 min-h-[44px]" data-coming-soon type="button">
              Registrarse
            </button>
          )}
        </div>
      </div>
    ) : (
      <a
        href={`mailto:equipo@dotnetecuador.com?subject=Notificarme%3A%20${encodeURIComponent(event.title)}`}
        class="btn-notify inline-flex items-center gap-2 min-h-[44px]"
      >
        Notificarme cuando se confirme
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    )}
  </div>

  </div><!-- /.event-card-v2__body -->

  {event.registrationComingSoon && (
    <dialog class="coming-soon-dialog" data-coming-soon-dialog>
      <div class="coming-soon-dialog__inner">
        <span class="coming-soon-dialog__icon">🚀</span>
        <h3 class="coming-soon-dialog__title">¡Registro próximamente!</h3>
        <p class="coming-soon-dialog__text">
          Estamos preparando todo para que puedas reservar tu lugar.<br/>
          ¡El cupo es limitado, estate atento!
        </p>
        <button class="coming-soon-dialog__close" data-coming-soon-close type="button">
          Entendido
        </button>
      </div>
    </dialog>
  )}

</article>

<style>
  /* ─── Card wrapper ───────────────────────────────────── */
  .event-card-v2 {
    background: white;
    border-radius: 1.25rem;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.08);
    padding: 1.25rem;
    transition: box-shadow 0.3s ease, transform 0.3s ease;
    border-left: 4px solid transparent;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* ─── Featured layout ────────────────────────────────── */
  .event-card-v2--featured {
    flex-direction: row;
    padding: 0;
    overflow: hidden;
  }

  .event-card-featured-image {
    flex-shrink: 0;
    width: 380px;
  }

  .event-card-featured-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .event-card-v2--featured .event-card-v2__body {
    flex: 1;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  @media (max-width: 639px) {
    .event-card-v2--featured {
      flex-direction: column;
    }

    .event-card-featured-image {
      width: 100%;
      height: 180px;
    }
  }

  .event-card-v2:hover {
    box-shadow: 0 12px 28px rgba(74, 8, 178, 0.14);
    transform: translateY(-3px);
  }

  .event-card-v2--confirmed:hover {
    border-left-color: #8b5dff;
  }

  .event-card-v2--confirmed {
    border-left-color: #4a08b2;
  }

  .event-card-v2--tentative {
    border-left-color: #c4b5ff;
  }

  /* ─── Date block ─────────────────────────────────────── */
  .event-date {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 72px;
    min-height: 80px;
    border-radius: 0.75rem;
    padding: 0.5rem 0.25rem;
    text-align: center;
    flex-shrink: 0;
  }

  .event-date--confirmed {
    background: #100123;
    color: white;
  }

  .event-date--tentative {
    border: 2px dashed #c4b5ff;
    color: #4a08b2;
  }

  .event-date__day {
    display: block;
    font-family: 'Exo 2', sans-serif;
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1;
  }

  .event-date__month {
    display: block;
    font-family: 'Exo 2', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-top: 0.2rem;
    opacity: 0.75;
  }

  .event-date__year {
    display: block;
    font-size: 0.6rem;
    opacity: 0.55;
    margin-top: 0.1rem;
  }

  .event-date__tentative {
    display: block;
    font-family: 'Exo 2', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    text-align: center;
    line-height: 1.3;
    padding: 0.25rem;
  }

  /* ─── Badges ─────────────────────────────────────────── */
  .event-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    font-size: 0.7rem;
    font-weight: 600;
    font-family: 'Jost', sans-serif;
    letter-spacing: 0.02em;
  }

  .event-badge--confirmed {
    background: #e0f2fe;
    color: #0369a1;
  }

  .event-badge--tentative {
    background: #ede9ff;
    color: #4a08b2;
    border: 1px dashed #c4b5ff;
  }

  .badge--presencial {
    background: #ede9ff;
    color: #1f085a;
    border: 1px solid #c4b5ff;
  }

  .badge--virtual {
    background: #f5f3ff;
    color: #4a08b2;
    border: 1px solid #ddd6ff;
  }

  .badge--hibrido {
    background: #f5f3ff;
    color: #4a08b2;
    border: 1px solid #ddd6fe;
  }

  .badge--type {
    background: #f4f4f5;
    color: #52525b;
    border: 1px solid #e4e4e7;
  }

  /* ─── Typography ─────────────────────────────────────── */
  .event-title {
    font-family: 'Exo 2', sans-serif;
    font-weight: 700;
    font-size: 1.25rem;
    color: #100123;
    line-height: 1.3;
    margin: 0 0 0.5rem 0;
  }

  @media (min-width: 640px) {
    .event-title { font-size: 1.375rem; }
  }

  .event-speakers {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin: 0 0 0.5rem 0;
  }

  .event-speaker {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .event-speaker__avatar-wrapper {
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    overflow: hidden;
    flex-shrink: 0;
    border: 2px solid #ede9ff;
  }

  .event-speaker__avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .event-speaker__info {
    font-family: 'Jost', sans-serif;
    font-size: 0.85rem;
    color: #4a08b2;
    font-weight: 500;
  }

  .event-description-wrapper {
    position: relative;
    margin-bottom: 0.75rem;
  }

  .event-description {
    font-family: 'Jost', sans-serif;
    font-size: 0.875rem;
    color: #52525b;
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .event-description.expanded {
    -webkit-line-clamp: unset;
    display: block;
  }

  .event-toggle {
    display: inline-block;
    font-family: 'Jost', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    color: #4a08b2;
    background: none;
    border: none;
    padding: 0.25rem 0;
    cursor: pointer;
    transition: color 0.2s ease;
    min-height: 44px;
  }

  .event-toggle:hover {
    color: #8b5dff;
  }

  .event-toggle:focus-visible {
    outline: 2px solid #8b5dff;
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* ─── Meta ───────────────────────────────────────────── */
  .event-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-bottom: 0.75rem;
  }

  .event-meta__item {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: 'Jost', sans-serif;
    font-size: 0.8rem;
    color: #71717a;
  }

  .event-meta__price {
    color: #4a08b2;
    font-weight: 600;
  }

  .event-meta__limited {
    color: #7c3aed;
    font-weight: 600;
  }

  /* ─── Tags ───────────────────────────────────────────── */
  .event-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .event-tag {
    font-size: 0.7rem;
    font-family: 'Jost', sans-serif;
    padding: 0.15rem 0.5rem;
    border-radius: 0.375rem;
    background: #f5f3ff;
    color: #4a08b2;
    border: 1px solid #ede9ff;
  }

  .badge--networking {
    background: #1f085a;
    color: #e9d5ff;
    border: 1px solid #4a08b2;
    font-weight: 700;
  }

  /* ─── Footer ─────────────────────────────────────────── */
  .event-footer {
    display: flex;
    justify-content: flex-end;
    border-top: 1px solid #f4f4f5;
    margin-top: auto;
    padding-top: 1rem;
  }

  /* ─── CTAs ───────────────────────────────────────────── */
  .btn-calendar {
    font-family: 'Jost', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.6rem 1.1rem;
    border-radius: 0.6rem;
    background: transparent;
    color: #4a08b2;
    border: 2px solid #4a08b2;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .btn-calendar:hover {
    background: #4a08b2;
    color: white;
    transform: translateY(-1px);
  }

  .btn-notify {
    font-family: 'Jost', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.6rem 1.1rem;
    border-radius: 0.6rem;
    border: 2px solid #8b5dff;
    color: #4a08b2;
    background: transparent;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .btn-notify:hover {
    background: #f5f3ff;
  }

  /* ─── Entrance animation ─────────────────────────────── */
  .animation-fade-up {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.4s ease-out, transform 0.4s ease-out;
  }

  .animation-fade-up.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .animation-fade-up {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* ─── Coming soon dialog ─────────────────────────────── */
  .coming-soon-dialog {
    border: none;
    border-radius: 1.25rem;
    padding: 0;
    max-width: 360px;
    width: calc(100vw - 2rem);
    box-shadow: 0 24px 48px rgba(31, 8, 90, 0.25);
    background: transparent;
  }

  .coming-soon-dialog::backdrop {
    background: rgba(16, 1, 35, 0.5);
    backdrop-filter: blur(4px);
  }

  .coming-soon-dialog__inner {
    background: linear-gradient(135deg, #1f085a 0%, #4a08b2 100%);
    border-radius: 1.25rem;
    padding: 2rem;
    text-align: center;
    color: white;
  }

  .coming-soon-dialog__icon {
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
    display: block;
  }

  .coming-soon-dialog__title {
    font-family: 'Exo 2', sans-serif;
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0 0 0.5rem 0;
    color: white;
  }

  .coming-soon-dialog__text {
    font-family: 'Jost', sans-serif;
    font-size: 0.9rem;
    color: rgba(255,255,255,0.8);
    line-height: 1.6;
    margin: 0 0 1.5rem 0;
  }

  .coming-soon-dialog__close {
    font-family: 'Jost', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.6rem 1.4rem;
    border-radius: 0.6rem;
    background: white;
    color: #1f085a;
    border: none;
    cursor: pointer;
    min-height: 44px;
    transition: background 0.2s ease;
  }

  .coming-soon-dialog__close:hover {
    background: #ede9ff;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-toggle]').forEach(btn => {
    btn.addEventListener('click', () => {
      const wrapper = btn.closest('.event-description-wrapper')
      const desc = wrapper?.querySelector<HTMLElement>('[data-description]')
      if (!desc) return
      const isExpanded = desc.classList.toggle('expanded')
      btn.textContent = isExpanded ? 'Ver menos' : 'Ver más'
      btn.setAttribute('aria-expanded', String(isExpanded))
    })
  })

  document.querySelectorAll<HTMLButtonElement>('[data-coming-soon]').forEach(btn => {
    btn.addEventListener('click', () => {
      const dialog = btn.closest('article')?.querySelector<HTMLDialogElement>('[data-coming-soon-dialog]')
      dialog?.showModal()
    })
  })

  document.querySelectorAll<HTMLButtonElement>('[data-coming-soon-close]').forEach(btn => {
    btn.addEventListener('click', () => {
      btn.closest('dialog')?.close()
    })
  })
</script>
